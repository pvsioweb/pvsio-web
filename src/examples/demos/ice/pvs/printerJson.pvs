  "     " + doublequote + "patient_updates" + doublequote + ": " + da`patient_updates +  ","+ newline +
  "     " + doublequote + "device_update" + doublequote + ": " + da`device_update +  ","+ newline +
  "     " + doublequote + "patient_connected" + doublequote + ": " + da`patient_connected +  ","+ newline +
  "     " + doublequote + "patient_device_connected" + doublequote + ": " + da`patient_device_connected +  ","+ newline +
  "     " + doublequote + "constraint_alarms" + doublequote + ": " + da`constraint_alarms + newline +
  "    }"
CONVERSION disp_alarm_type2string

i_state2string(is: i_state): string =
  "{ " + newline + 
  "   " + doublequote + "nde" + doublequote + ": " + is`nde +  ","+ newline +
  "   " + doublequote + "mode" + doublequote + ": " + is`mode +  ","+ newline +
  "   " + doublequote + "prev_menu_entry" + doublequote + ": " + is`prev_menu_entry +  ","+ newline +
  "   " + doublequote + "prev_menu_visible" + doublequote + ": " + menu_set2string(is`prev_menu_visible) +  ","+ newline +
  "   " + doublequote + "disp_focus" + doublequote + ": " + is`disp_focus +  ","+ newline +
  "   " + doublequote + "disp_top" + doublequote + ": " + is`disp_top +  ","+ newline +
  "   " + doublequote + "disp_alarm" + doublequote + ": " + is`disp_alarm +  ","+ newline +
  "   " + doublequote + "disp_patient" + doublequote + ": " + is`disp_patient +  ","+ newline +
  "   " + doublequote + "disp_device" + doublequote + ": " + is`disp_device +  ","+ newline +
  "   " + doublequote + "coord_db" + doublequote + ": " + is`coord_db + newline + newline +
  "  }"
CONVERSION i_state2string

patient_db_type2string(pd: patient_db_type): string =
"[" + patient_db_printer(pd, plimit) + "]"
  CONVERSION patient_db_type2string

print_state(st: state): string =
 LET ans = "{" + newline,
     ans = ans + doublequote + "nde_state" + doublequote + ": " + n_state2string(st`nde_state) + ","+ newline,
    ans = ans + doublequote + "p_nodes" + doublequote + ": " + node_to_patient2string(st`p_nodes) +  ","+ newline, %Comentado
    ans = ans + doublequote + "d_nodes" + doublequote + ": " + node_to_pd2string(st`d_nodes) +  "," + newline, %Comentado
     ans = ans + doublequote + "ps" + doublequote + ": " + nodes2string(st`ps) +  ","+ newline,
     ans = ans + doublequote + "patient_nodes" + doublequote + ": " + nodes2string(st`patient_nodes) +  ","+ newline,
     ans = ans + doublequote + "patient menus" + doublequote + ": {}" +  "," + newline,
     ans = ans + doublequote + "pdb" + doublequote + ": " + patient_db_type2string(st`pdb) + ","+ newline ,
     ans = ans + doublequote + "coord_st" + doublequote + ": " + i_state2string(st`coord_st) +  ","+ newline,
     ans = ans + doublequote + "coord_menu" + doublequote + ": {}" + newline
     %ans = ans + "comms_error := " + nw_error_type2string(st`comms_error) + newline
   IN ans + "}"
   
  filter_coord_menu(st: state): list[coord_t_and_c_th.menu] = 
    LET
      coord_m: coord_menu.menu_type = st`coord_menu,
      dom: setof[coord_t_and_c_th.menu] = {x: coord_t_and_c_th.menu | TRUE } % domain of coord_menu??
    IN (: select,
          cursor_up,
          cursor_down,
          display,
          patient,
          device,
          action,
          escape :)

  click_coord_menu_select(st: state): state = st
  click_coord_menu_cursor_up(st: state): state = st

%%%  JSON printer

to_json_coord_disp_top_type(st: coord_disp_top_type): string = 
  LET json = "{" + doublequote + "typedoublequote:" + doublequote + "coord_disp_top_typedoublequote," + doublequote + "valuedoublequote: {",
      json = json + doublequote + "patientsdoublequote: {doublequotetypedoublequote:" + doublequote + "patients_typedoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "selected_patientdoublequote: {doublequotetypedoublequote:" + doublequote + "patientdoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "patients_enum_paramsdoublequote: {doublequotetypedoublequote:" + doublequote + "top_enum_paramsdoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "patients_num_paramsdoublequote: {doublequotetypedoublequote:" + doublequote + "top_num_paramsdoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "menu_visibledoublequote: "+ menu_set2string(st`menu_visible)+", ",
      json = json + doublequote + "ent_devicedoublequote: {doublequotetypedoublequote:" + doublequote + "devicedoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "ent_patientdoublequote: {doublequotetypedoublequote:" + doublequote + "patientdoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "ent_actiondoublequote: {doublequotetypedoublequote:" + doublequote + "action_iddoublequote," + doublequote + "valuedoublequote: {}}"
  IN json + "}}"

to_json_coord_st(st: i_state): string = 
  LET json = "{doublequotetypedoublequote:" + doublequote + "i_statedoublequote," + doublequote + "valuedoublequote: {",
      json = json + doublequote + "ndedoublequote: {doublequotetypedoublequote:" + doublequote + "nodedoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "modedoublequote: {doublequotetypedoublequote:" + doublequote + "patient_mode_typedoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "prev_menu_entrydoublequote: {doublequotetypedoublequote:" + doublequote + "menudoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "prev_menu_visibledoublequote: {doublequotetypedoublequote:" + doublequote + "menu_setdoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "disp_focusdoublequote: {doublequotetypedoublequote:" + doublequote + "disp_focus_typedoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "disp_topdoublequote: "+to_json_coord_disp_top_type(st`disp_top)+", ",
      json = json + doublequote + "disp_alarmdoublequote: {doublequotetypedoublequote:" + doublequote + "disp_alarm_typedoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "disp_patientdoublequote: {doublequotetypedoublequote:" + doublequote + "disp_patient_typedoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "disp_devicedoublequote: {doublequotetypedoublequote:" + doublequote + "disp_device_typedoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "coord_dbdoublequote: {doublequotetypedoublequote:" + doublequote + "coord_db_typedoublequote," + doublequote + "valuedoublequote: {}}"
  IN json + "}}"

to_json(st: state): string =
  LET json = "{doublequotetypedoublequote:" + doublequote + "statedoublequote," + doublequote + "valuedoublequote: {",
      json = json + doublequote + "nde_statedoublequote: {doublequotetypedoublequote:" + doublequote + "n_statedoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "p_nodesdoublequote: {doublequotetypedoublequote:" + doublequote + "node_to_patientdoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "d_nodesdoublequote: {doublequotetypedoublequote:" + doublequote + "node_to_pddoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "psdoublequote: {doublequotetypedoublequote:" + doublequote + "patients_typedoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "patient_nodesdoublequote: {doublequotetypedoublequote:" + doublequote + "nodesdoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "patient_menusdoublequote: {doublequotetypedoublequote:" + doublequote + "patient_mn_typedoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "pdbdoublequote: {doublequotetypedoublequote:" + doublequote + "patient_db_typedoublequote," + doublequote + "valuedoublequote: {}}, ",
      json = json + doublequote + "coord_stdoublequote: "+to_json_coord_st(st`coord_st)+", ",
      json = json + doublequote + "coord_menudoublequote: {doublequotetypedoublequote:" + doublequote + "coord_menu.menu_typedoublequote," + doublequote + "valuedoublequote: {}}"
  IN json + "}}"

  
END printerJson
