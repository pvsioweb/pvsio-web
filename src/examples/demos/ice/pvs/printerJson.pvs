printerJson[
    maxrate: posnat, 
    maxinfuse: posnat, 
    maxtime: {maxtime: posnat | maxinfuse <= maxtime}
]: THEORY
  BEGIN 
    IMPORTING system_th[maxrate, maxinfuse, maxtime]
   mindex: nat = 16
   nlimit: nat = 16
   dlimit: nat = 16
   plimit: nat = 16
   last_patient: nat = 2
   
  action_id2string(a: action_id): string =
   COND
    a = powr -> doublequote + "powr" + doublequote,
    a = incr -> doublequote + "incr" + doublequote,
    a = decr -> doublequote + "decr" + doublequote,
    a = bolus -> doublequote + "bolus" + doublequote,
    a = confirm -> doublequote + "confirm" + doublequote,
    a = choosetime -> doublequote + "choosetime" + doublequote,
    a = choosevtbi -> doublequote + "choosevtbi" + doublequote,
    a = chooserate -> doublequote + "chooserate" + doublequote,
    a = start -> doublequote + "start" + doublequote,
    a = hold -> doublequote + "hold" + doublequote,
    a = tick -> doublequote + "tick" + doublequote,
    a = openclamp -> doublequote + "openclamp" + doublequote,
    a = closeclamp -> doublequote + "closeclamp" + doublequote,
    a = nil_action -> doublequote + "nil_action" + doublequote
    ENDCOND
  CONVERSION action_id2string

action_ids2string(fs: action_ids): string =
  LET ans = "[ ",
      ans = IF fs(powr) THEN ans + doublequote + "powr" + doublequote ELSE ans ENDIF,
      ans = ans + IF fs(powr) AND (fs(incr) OR fs(decr) OR fs(bolus) OR 
                       fs(confirm) OR fs(choosetime) OR fs(choosevtbi) OR
                       fs(chooserate) OR fs(start) OR fs(hold) OR fs(tick) OR
                       fs(openclamp) OR fs(closeclamp) OR fs(nil_action))
                    THEN ", " ELSE "" ENDIF,
      ans = IF fs(incr) THEN ans + doublequote + "incr" + doublequote ELSE ans ENDIF,
      ans = ans + IF fs(incr) AND (fs(decr) OR fs(bolus) OR 
                       fs(confirm) OR fs(choosetime) OR fs(choosevtbi) OR
                       fs(chooserate) OR fs(start) OR fs(hold) OR fs(tick) OR
                       fs(openclamp) OR fs(closeclamp) OR fs(nil_action))
                    THEN ", " ELSE "" ENDIF,
      ans = IF fs(decr) THEN ans + doublequote + "decr" + doublequote ELSE ans ENDIF,
      ans = ans + IF fs(decr) AND (fs(bolus) OR 
                       fs(confirm) OR fs(choosetime) OR fs(choosevtbi) OR
                       fs(chooserate) OR fs(start) OR fs(hold) OR fs(tick) OR
                       fs(openclamp) OR fs(closeclamp) OR fs(nil_action))
                    THEN ", " ELSE "" ENDIF,
      ans = IF fs(bolus) THEN ans + doublequote + "bolus" + doublequote ELSE ans ENDIF,
      ans = ans + IF fs(bolus) AND (fs(confirm) OR fs(choosetime) OR fs(choosevtbi) OR
                       fs(chooserate) OR fs(start) OR fs(hold) OR fs(tick) OR
                       fs(openclamp) OR fs(closeclamp) OR fs(nil_action))
                    THEN ", " ELSE "" ENDIF,
      ans = IF fs(confirm) THEN ans + doublequote + "confirm" + doublequote ELSE ans ENDIF,
      ans = ans + IF fs(confirm) AND (fs(choosetime) OR fs(choosevtbi) OR
                       fs(chooserate) OR fs(start) OR fs(hold) OR fs(tick) OR
                       fs(openclamp) OR fs(closeclamp) OR fs(nil_action))
                    THEN ", " ELSE "" ENDIF,
      ans = IF fs(choosetime) THEN ans + doublequote + "choosetime" + doublequote ELSE ans ENDIF,
      ans = ans + IF fs(choosetime) AND (fs(choosevtbi) OR
                       fs(chooserate) OR fs(start) OR fs(hold) OR fs(tick) OR
                       fs(openclamp) OR fs(closeclamp) OR fs(nil_action))
                    THEN ", " ELSE "" ENDIF,
      ans = IF fs(choosevtbi) THEN ans + doublequote + "choosevtbi" + doublequote ELSE ans ENDIF,
      ans = ans + IF fs(choosevtbi) AND (fs(chooserate) OR fs(start) OR fs(hold) OR fs(tick) OR
                       fs(openclamp) OR fs(closeclamp) OR fs(nil_action))
                    THEN ", " ELSE "" ENDIF,
      ans = IF fs(chooserate) THEN ans + doublequote + "chooserate" + doublequote ELSE ans ENDIF,
      ans = ans + IF fs(chooserate) AND (fs(start) OR fs(hold) OR fs(tick) OR
                       fs(openclamp) OR fs(closeclamp) OR fs(nil_action))
                    THEN ", " ELSE "" ENDIF,
      ans = IF fs(start) THEN ans + doublequote + "start" + doublequote ELSE ans ENDIF,
      ans = ans + IF fs(start) AND (fs(hold) OR fs(tick) OR
                       fs(openclamp) OR fs(closeclamp) OR fs(nil_action))
                    THEN ", " ELSE "" ENDIF,
      ans = IF fs(hold) THEN ans + doublequote + "hold" + doublequote ELSE ans ENDIF,
      ans = ans + IF fs(hold) AND (fs(tick) OR
                       fs(openclamp) OR fs(closeclamp) OR fs(nil_action))
                    THEN ", " ELSE "" ENDIF,
      ans = IF fs(tick) THEN ans + doublequote + "tick" + doublequote ELSE ans ENDIF,
      ans = ans + IF fs(tick) AND (fs(openclamp) OR fs(closeclamp) OR fs(nil_action))
                    THEN ", " ELSE "" ENDIF,
      ans = IF fs(openclamp) THEN ans + doublequote + "openclamp" + doublequote ELSE ans ENDIF,
      ans = ans + IF fs(openclamp) AND (fs(closeclamp) OR fs(nil_action))
                    THEN ", " ELSE "" ENDIF,
      ans = IF fs(closeclamp) THEN ans + doublequote + "closeclamp" + doublequote ELSE ans ENDIF,
      ans = ans + IF fs(closeclamp) AND (fs(nil_action))
                    THEN ", " ELSE "" ENDIF,
      ans = IF fs(nil_action) THEN ans + doublequote + "nil_action" + doublequote ELSE ans ENDIF
   IN ans + " ]"
  CONVERSION action_ids2string

rel_op_type2string(r: rel_op_type): string =
  COND
    r = lt -> doublequote + "lt" + doublequote,
    r = le -> doublequote + "le" + doublequote,
    r = gt -> doublequote + "gt" + doublequote,
    r = ge -> doublequote + "ge" + doublequote,
    r = eq -> doublequote + "eq" + doublequote,
    r = neq -> doublequote + "neq" + doublequote,
    r = no_rel -> doublequote + "no_rel" + doublequote
  ENDCOND
CONVERSION rel_op_type2string

relset2string(rs: relset): string =
 LET ans = "[ ",
      ans = IF rs(lt) THEN ans + doublequote + "lt" + doublequote ELSE ans ENDIF,
      ans = ans + IF rs(lt) AND (rs(le) OR rs(gt) OR rs(ge) OR 
                       rs(eq) OR rs(neq) OR rs(no_rel))
                    THEN ", " ELSE "" ENDIF,
      ans = IF rs(le) THEN ans + doublequote + "le" + doublequote ELSE ans ENDIF,
      ans = ans + IF rs(le) AND (rs(gt) OR rs(ge) OR 
                       rs(eq) OR rs(neq) OR rs(no_rel))
                    THEN ", " ELSE "" ENDIF,
      ans = IF rs(gt) THEN ans + doublequote + "gt" + doublequote ELSE ans ENDIF,
      ans = ans + IF rs(gt) AND (rs(ge) OR 
                       rs(eq) OR rs(neq) OR rs(no_rel))
                    THEN ", " ELSE "" ENDIF,
      ans = IF rs(ge) THEN ans + doublequote + "ge" + doublequote ELSE ans ENDIF,
      ans = ans + IF rs(ge) AND (rs(eq) OR rs(neq) OR rs(no_rel))
                    THEN ", " ELSE "" ENDIF,
      ans = IF rs(eq) THEN ans + doublequote + "eq" + doublequote ELSE ans ENDIF,
      ans = ans + IF rs(eq) AND (rs(neq) OR rs(no_rel))
                    THEN ", " ELSE "" ENDIF,
      ans = IF rs(neq) THEN ans + doublequote + "neq" + doublequote ELSE ans ENDIF,
      ans = ans + IF rs(neq) AND (rs(no_rel))
                    THEN ", " ELSE "" ENDIF,
      ans = IF rs(no_rel) THEN ans + doublequote + "no_rel" + doublequote ELSE ans ENDIF
   IN ans + " ]"
  CONVERSION relset2string

device_type2string(dt: device_type): string =
  COND
   dt = infusion_pump -> doublequote + "infusion_pump" + doublequote,
   dt = vital_signs_device -> doublequote + "vital_signs_device" + doublequote,
   dt = no_device -> doublequote + "no_device" + doublequote
  ENDCOND
 CONVERSION device_type2string

device2string(d: device): string = "" + d


devs_type2string(dst: devs_type): string =
"{" + doublequote + "dv" + doublequote + ": " + dst`dv + "," + space +
 doublequote + "dt" + doublequote + ": " + dst`dt + " }"
CONVERSION devs_type2string

disp_focus_type2string(df: disp_focus_type): string =
COND
   df = no_focus -> doublequote + "no_focus" + doublequote,
   df = top_focus -> doublequote + "top_focus" + doublequote,
   df = patient_focus -> doublequote + "patient_focus" + doublequote,
   df = device_focus -> doublequote + "device_focus" + doublequote
  ENDCOND
 CONVERSION disp_focus_type2string

mode2string(m: mode): string =
   COND
    m = off -> doublequote + "off" + doublequote,
    m = pause     -> doublequote + "pause" + doublequote,
    m = infuse  -> doublequote + "infuse" + doublequote
    ENDCOND
  CONVERSION mode2string

dispmode2string(dm: dispmode): string =
   COND
    dm = dblank -> doublequote + "dblank" + doublequote,
    dm = mainmenu     -> doublequote + "mainmenu" + doublequote,
    dm = dvtbi  -> doublequote + "dvtbi" + doublequote,
    dm = drate -> doublequote + "drate" + doublequote,
    dm = dtime -> doublequote + "dtime" + doublequote,
    dm = dinfusing -> doublequote + "dinfusing" + doublequote,
    dm = dalarm -> doublequote + "dalarm" + doublequote,
    dm = dkvo -> doublequote + "dkvo" + doublequote
    ENDCOND
  CONVERSION dispmode2string

clamp_state2string(c: clamp_state): string =
   COND
    c = open -> doublequote + "open" + doublequote,
    c = closed     -> doublequote + "closed" + doublequote
    ENDCOND
  CONVERSION clamp_state2string

priority_type2string(p: priority_type): string =
   COND
    p = rte -> doublequote + "rte" + doublequote,
    p = tme     -> doublequote + "tme" + doublequote
    ENDCOND
  CONVERSION priority_type2string

menu2string(m: menu): string =
COND
    m = no_action -> doublequote + "no_action" + doublequote,
    m = delete -> doublequote + "delete" + doublequote,
    m = cursor_up -> doublequote + "cursor_up" + doublequote,
    m = cursor_down -> doublequote + "cursor_down" + doublequote,
    m = select -> doublequote + "select" + doublequote,
    m = enter -> doublequote + "enter" + doublequote,
    m = top     -> doublequote + "top" + doublequote,
    m = main  -> doublequote + "main" + doublequote,
    m = patient -> doublequote + "patient" + doublequote,
    m = device -> doublequote + "device" + doublequote,
    m = region -> doublequote + "region" + doublequote,
    m = rule -> doublequote + "rule" + doublequote,
    m = constraint -> doublequote + "constraint" + doublequote,
    m = edit -> doublequote + "edit" + doublequote,
    m = clear -> doublequote + "clear" + doublequote,
    m = display -> doublequote + "display" + doublequote,
    m = parameter -> doublequote + "parameter" + doublequote,
    m = action     -> doublequote + "action" + doublequote,
    m = relation  -> doublequote + "relation" + doublequote,
    m = num_value -> doublequote + "num_value" + doublequote,
    m = enum_value -> doublequote + "enum_value" + doublequote,
    m = escape -> doublequote + "escape" + doublequote,
    m = pump -> doublequote + "pump" + doublequote,
    m = vs_device -> doublequote + "vs_device" + doublequote
    ENDCOND
  CONVERSION menu2string

