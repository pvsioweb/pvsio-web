  doublequote + "r" + doublequote + ": " + ec`r + ", "+ newline +
  doublequote + "v" + doublequote + ": " + ec`v + newline + " }"
CONVERSION enum_constraint_type2string

num_constraint_type2string(nc: num_constraint_type): string =
 "{ " + doublequote + "d" + doublequote + ": " + nc`d + ", " + newline +
       doublequote + "p" + doublequote + ": " + nc`p + ", " + newline +
       doublequote + "r" + doublequote + ": " + nc`r + ", " + newline +
       doublequote + "v" + doublequote + ": " + nc`v + newline + " }"
  CONVERSION num_constraint_type2string

constraint_type2string(ct: constraint_type): string =
    "{ " + doublequote + "vt" + doublequote + ": " + ct`vt + ", "+ newline +
       doublequote + "nc" + doublequote + ": " + ct`nc + ", "+ newline +
       doublequote + "ec" + doublequote + ": " + ct`ec + newline + " }"
    CONVERSION constraint_type2string

has_previous_production_type_printer(l: [ upto(climit) -> constraint_type ], c: cindex): RECURSIVE bool =
  COND
    c = 0 -> IF l(c)`vt /= empty THEN TRUE ELSE FALSE ENDIF,
    c > 0 -> IF l(c)`vt /= empty THEN TRUE ELSE has_previous_production_type_printer(l, c-1) ENDIF 
  ENDCOND
  MEASURE c

production_type_printer(l: [ upto(climit) -> constraint_type ], c: cindex): RECURSIVE string =
 COND
      c = 0 -> IF l(c)`vt /= empty THEN l(c) + newline ELSE
               "" ENDIF,
      c > 0 -> IF l(c)`vt /= empty AND has_previous_production_type_printer(l, c-1)
               THEN production_type_printer(l, c - 1) + "," + space + l(c)
	       ELSIF l(c)`vt /= empty THEN l(c) ELSE production_type_printer(l, c - 1) ENDIF
    ENDCOND
  MEASURE c
  
production_type2string(pt: production_type): string =
"[ " + production_type_printer(pt, climit) + "]"
  CONVERSION production_type2string

rule_type2string(rt: rule_type): string =
 "{ " + doublequote + "rule" + doublequote + ": " + rt`rule + ", "+ newline +
       doublequote + "action" + doublequote + ": " + rt`action + newline + 
  " }" 
  CONVERSION rule_type2string

has_previous_patient_constraint_printer(l: [ upto(climit) -> rule_type ], c: cindex): RECURSIVE bool =
  COND
    c = 0 -> IF (l(c)`action)`act /= nil_action THEN TRUE ELSE FALSE ENDIF,
    c > 0 -> IF (l(c)`action)`act /= nil_action THEN TRUE ELSE has_previous_patient_constraint_printer(l, c-1) ENDIF 
  ENDCOND
  MEASURE c

patient_constraint_printer(l: [ upto(climit) -> rule_type ], c: cindex): RECURSIVE string =
 COND
      c = 0 -> IF (l(c)`action)`act /= nil_action THEN l(c) + newline ELSE
               "" ENDIF,
      c > 0 -> IF (l(c)`action)`act /= nil_action AND has_previous_patient_constraint_printer(l, c-1)
               THEN patient_constraint_printer(l, c - 1) + "," + space + l(c)
	       ELSIF (l(c)`action)`act /= nil_action THEN l(c) ELSE patient_constraint_printer(l, c - 1) ENDIF
    ENDCOND
  MEASURE c



