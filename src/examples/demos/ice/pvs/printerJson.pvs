has_previous_pan_msg_waiting_printer(l: [ upto(nlimit) -> pan_q_type ], n: node): RECURSIVE bool =
  COND
    n = 0 -> IF l(n)`buf_status /= empty THEN TRUE ELSE FALSE ENDIF,
    n > 0 -> IF l(n)`buf_status /= empty THEN TRUE ELSE has_previous_pan_msg_waiting_printer(l, n-1) ENDIF 
  ENDCOND
  MEASURE n

pan_msg_waiting_printer(l: [ upto(nlimit) -> pan_q_type ], n: node): RECURSIVE string =
 COND
      n = 0 -> IF l(n)`buf_status /= empty THEN "{" + doublequote + "node" + doublequote + ":" + n + "," + doublequote + "msgs" + doublequote + ":" + l(n) + "}" ELSE
               "" ENDIF,
      n > 0 -> IF l(n)`buf_status /= empty AND has_previous_pan_msg_waiting_printer(l, n-1)
               THEN pan_msg_waiting_printer(l, n - 1) + "," + space + "{" + doublequote + "node" + doublequote + ":" + n + "," + doublequote + "msgs" + doublequote + ":" + l(n) + "}"
	       ELSIF l(n)`buf_status /= empty THEN "{" + doublequote + "node" + doublequote + ":" + n + "," + doublequote + "msgs" + doublequote + ":" + l(n) + "}" ELSE pan_msg_waiting_printer(l, n - 1) ENDIF
    ENDCOND
  MEASURE n

has_previous_act_msg_waiting_printer(l: [ upto(nlimit) -> act_q_type ], n: node): RECURSIVE bool =
  COND
    n = 0 -> IF l(n)`buf_status /= empty THEN TRUE ELSE FALSE ENDIF,
    n > 0 -> IF l(n)`buf_status /= empty THEN TRUE ELSE has_previous_act_msg_waiting_printer(l, n-1) ENDIF 
  ENDCOND
  MEASURE n

act_msg_waiting_printer(l: [ upto(nlimit) -> act_q_type ], n: node): RECURSIVE string =
 COND
      n = 0 -> IF l(n)`buf_status /= empty THEN "{" + doublequote + "node" + doublequote + ":" + n + "," + doublequote + "msgs" + doublequote + ":" + l(n) + "}" ELSE
               "" ENDIF,
      n > 0 -> IF l(n)`buf_status /= empty AND has_previous_act_msg_waiting_printer(l, n-1)
               THEN act_msg_waiting_printer(l, n - 1) + "," + space + "{" + doublequote + "node" + doublequote + ":" + n + "," + doublequote + "msgs" + doublequote + ":" + l(n) + "}"
	       ELSIF l(n)`buf_status /= empty THEN "{" + doublequote + "node" + doublequote + ":" + n + "," + doublequote + "msgs" + doublequote + ":" + l(n) + "}" ELSE act_msg_waiting_printer(l, n - 1) ENDIF
    ENDCOND
  MEASURE n

has_previous_d_panel_type_printer(l: [ upto(dlimit) -> panel], d: device): RECURSIVE bool =
  COND
    d = 0 -> IF l(d)`pars /= emptyset THEN TRUE ELSE FALSE ENDIF,
    d > 0 -> IF l(d)`pars /= emptyset THEN TRUE ELSE has_previous_d_panel_type_printer(l, d-1) ENDIF 
  ENDCOND
  MEASURE d

d_panel_type_printer(l: [ upto(dlimit) -> panel], d: device): RECURSIVE string =
 COND
      d = 0 -> 
        IF l(d)`pars /= emptyset THEN "{" + doublequote + "d" + doublequote + " : " + d + "," + doublequote + "val" + doublequote + " : " + l(d) + "}" ELSE "" ENDIF,
      d > 0 -> 
        IF l(d)`pars /= emptyset AND has_previous_d_panel_type_printer(l, d-1)
        THEN d_panel_type_printer(l, d - 1) + "," + "{" + doublequote + "d" + doublequote + " : " + d + "," + doublequote + "val" + doublequote + " : " + l(d) + "}"
        ELSIF l(d)`pars /= emptyset THEN "{" + doublequote + "d" + doublequote + " : " + d + "," + doublequote + "val" + doublequote + " : " + l(d) + "}" ELSE d_panel_type_printer(l, d - 1) ENDIF
  ENDCOND
MEASURE d

has_previous_p_dstates_printer(l: [upto(dlimit) -> d_state], d: device): RECURSIVE bool =
  COND
    d = 0 -> IF l(d)`nde /= no_node  THEN TRUE ELSE FALSE ENDIF,
    d > 0 -> IF l(d)`nde /= no_node THEN TRUE ELSE has_previous_p_dstates_printer(l, d-1) ENDIF 
  ENDCOND
  MEASURE d

p_dstates_printer(l: [upto(dlimit) -> d_state], d: device): RECURSIVE string =
   COND
      d = 0 -> IF l(d)`nde /= no_node THEN "" + l(d) ELSE
               "" ENDIF,
      d > 0 -> IF l(d)`nde /= no_node AND has_previous_p_dstates_printer(l, d-1)
               THEN p_dstates_printer(l, d - 1) + "," + space + l(d)
	       ELSIF l(d)`nde /= no_node THEN l(d) ELSE p_dstates_printer(l, d - 1) ENDIF
    ENDCOND
  MEASURE d

has_previous_main_act_printer(l: [upto(dlimit) -> action_ids], d: device): RECURSIVE bool =
  COND
    d = 0 -> IF l(d) /= emptyset THEN TRUE ELSE FALSE ENDIF,
    d > 0 -> IF l(d) /= emptyset THEN TRUE ELSE has_previous_main_act_printer(l, d-1) ENDIF 
  ENDCOND
  MEASURE d

main_act_printer(l: [upto(dlimit) -> action_ids], d: device): RECURSIVE string =
   COND
      d = 0 -> IF l(d) /= emptyset THEN "{" + doublequote + "d" + doublequote + " : " + d + "," + doublequote + "val" + doublequote + " : " + l(d) + "}" ELSE
               "" ENDIF,
      d > 0 -> IF l(d) /= emptyset AND has_previous_main_act_printer(l, d-1)
               THEN main_act_printer(l, d - 1) + "," + space + "{" + doublequote + "d" + doublequote + " : " + d + "," + doublequote + "val" + doublequote + " : " + l(d) + "}"
	       ELSIF l(d) /= emptyset  THEN "{" + doublequote + "d" + doublequote + " : " + d + "," + doublequote + "val" + doublequote + " : " + l(d) + "}" ELSE main_act_printer(l, d - 1) ENDIF
    ENDCOND
  MEASURE d

has_previous_main_enum_par_printer(l: [upto(dlimit) -> enum_parameter], d: device): RECURSIVE bool =
  COND
    d = 0 -> IF l(d) /= empty_enum_parameter THEN TRUE ELSE FALSE ENDIF,
    d > 0 -> IF l(d) /= empty_enum_parameter THEN TRUE ELSE has_previous_main_enum_par_printer(l, d-1) ENDIF 
  ENDCOND
