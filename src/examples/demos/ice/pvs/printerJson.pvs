main_enum_par_printer(l: [upto(dlimit) -> enum_parameter], d: device): RECURSIVE string =
   COND
      d = 0 -> IF l(d) /= empty_enum_parameter THEN "{" + doublequote + "d" + doublequote + " : " + d + "," + doublequote + "val" + doublequote + " : " + l(d) + "}" ELSE
               "" ENDIF,
      d > 0 -> IF l(d) /= empty_enum_parameter AND has_previous_main_enum_par_printer(l, d-1)
               THEN main_enum_par_printer(l, d - 1) + "," + space + "{" + doublequote + "d" + doublequote + " : " + d + "," + doublequote + "val" + doublequote + " : " + l(d) + "}"
	       ELSIF l(d) /= empty_enum_parameter THEN "{" + doublequote + "d" + doublequote + " : " + d + "," + doublequote + "val" + doublequote + " : " + l(d) + "}" ELSE main_enum_par_printer(l, d - 1) ENDIF
    ENDCOND
  MEASURE d

has_previous_main_num_par_printer(l: [upto(dlimit) -> num_parameter], d: device): RECURSIVE bool =
  COND
    d = 0 -> IF l(d) /= empty_num_parameter THEN TRUE ELSE FALSE ENDIF,
    d > 0 -> IF l(d) /= empty_num_parameter THEN TRUE ELSE has_previous_main_num_par_printer(l, d-1) ENDIF 
  ENDCOND
  MEASURE d

% AQUI
main_num_par_printer(l: [upto(dlimit) -> num_parameter], d: device): RECURSIVE string =
   COND
      d = 0 -> IF l(d) /= empty_num_parameter
		  THEN "{" + doublequote + "d" + doublequote + " : " + d + "," + doublequote + "val" + doublequote + " : " + l(d) + "}" ELSE
               "" ENDIF,
      d > 0 -> IF l(d) /= empty_num_parameter AND has_previous_main_num_par_printer(l, d-1)
               THEN main_num_par_printer(l, d - 1) + "," + space + "{" + doublequote + "d" + doublequote + " : " + d + "," + doublequote + "val" + doublequote + " : " + l(d) + "}"
	       ELSIF l(d) /= empty_num_parameter THEN "{" + doublequote + "d" + doublequote + " : " + d + "," + doublequote + "val" + doublequote + " : " + l(d) + "}" ELSE main_num_par_printer(l, d - 1) ENDIF
    ENDCOND
  MEASURE d

 main_enum_par2string(mep: main_enum_par): string =
"[ " + main_enum_par_printer(mep, dlimit) + "]"
  CONVERSION main_enum_par2string

has_previous_action_error_printer(l: [upto(plimit) -> dev_act_type], p: patient): RECURSIVE bool =
  COND
    p = 0 -> IF l(p)`dev /= nil_device THEN TRUE ELSE FALSE ENDIF,
    p > 0 -> IF l(p)`dev /= nil_device THEN TRUE ELSE has_previous_action_error_printer(l, p-1) ENDIF 
  ENDCOND
  MEASURE p

action_error_printer(l: [upto(plimit) -> dev_act_type], p: patient): RECURSIVE string =
   COND
      p = 0 -> IF l(p)`dev /= nil_device THEN "{" + doublequote + "p" + doublequote + " : " + p + "," + doublequote + "val" + doublequote + " : " + l(p) + "}" ELSE
                "" ENDIF,
      p > 0 -> IF l(p)`dev /= nil_device AND has_previous_action_error_printer(l, p-1) THEN action_error_printer(l, p - 1) + "," + space + "{" + doublequote + "p" + doublequote + " : " + p + "," + doublequote + "val" + doublequote + " : " + l(p) + "}"
              ELSIF l(p)`dev /= nil_device THEN "{" + doublequote + "p" + doublequote + " : " + p + "," + doublequote + "val" + doublequote + " : " + l(p) + "}" ELSE action_error_printer(l, p - 1) ENDIF
    ENDCOND
  MEASURE p


action_error_type2string(aet: action_error_type): string =
"[ " + action_error_printer(aet, plimit) + "]"
CONVERSION action_error_type2string

has_previous_top_enum_par_printer(l: [upto(plimit) -> main_enum_par], p: patient): RECURSIVE bool =
  COND
    p = 0 -> IF has_previous_main_enum_par_printer(l(p), dlimit) THEN TRUE ELSE FALSE ENDIF,
    p > 0 -> IF has_previous_main_enum_par_printer(l(p), dlimit) THEN TRUE ELSE has_previous_top_enum_par_printer(l, p-1) ENDIF 
  ENDCOND
  MEASURE p


top_enum_par_printer(l: [upto(plimit) -> main_enum_par], p: patient): RECURSIVE string =
   COND
      p = 0 -> IF has_previous_main_enum_par_printer(l(p), dlimit) THEN "{" + doublequote + "p" + doublequote + " : " + p + "," + doublequote + "val" + doublequote + " : " + l(p) + "}" ELSE "" ENDIF,
      p > 0 -> IF has_previous_main_enum_par_printer(l(p), dlimit) AND has_previous_top_enum_par_printer(l, p-1) THEN
      top_enum_par_printer(l, p - 1) + "," + space + "{" + doublequote + "p" + doublequote + " : " + p + "," + doublequote + "val" + doublequote + " : " + l(p) + "}"
      ELSIF has_previous_main_enum_par_printer(l(p), dlimit) THEN "{" + doublequote + "p" + doublequote + " : " + p + "," + doublequote + "val" + doublequote + " : " + l(p) + "}" ELSE top_enum_par_printer(l, p - 1) ENDIF
    ENDCOND
  MEASURE p

top_enum_params2string(tep: top_enum_params): string =
"[ " + top_enum_par_printer(tep, plimit) + "]"
CONVERSION top_enum_params2string

main_num_par2string(mnp: main_num_par): string =
"[ " + main_num_par_printer(mnp, dlimit) + "]"
  CONVERSION main_num_par2string

has_previous_top_num_par_printer(l: [upto(plimit) -> main_num_par], p: patient): RECURSIVE bool =
  COND
    p = 0 -> IF has_previous_main_num_par_printer(l(p), dlimit) THEN TRUE ELSE FALSE ENDIF,
    p > 0 -> IF has_previous_main_num_par_printer(l(p), dlimit) THEN TRUE ELSE has_previous_top_num_par_printer(l, p-1) ENDIF 
  ENDCOND
  MEASURE p

top_num_par_printer(l: [upto(plimit) -> main_num_par], p: patient): RECURSIVE string =
   COND
      p = 0 -> IF has_previous_main_num_par_printer(l(p), dlimit) THEN 
      "{" + doublequote + "p" + doublequote + " : " + p + "," + doublequote + "val" + doublequote + " : " + l(p) + "}" ELSE "" ENDIF,
      p > 0 -> IF has_previous_main_num_par_printer(l(p), dlimit) AND has_previous_top_num_par_printer(l, p-1) THEN
      top_num_par_printer(l, p - 1) + "," + space + "{" + doublequote + "p" + doublequote + " : " + p + "," + doublequote + "val" + doublequote + " : " + l(p) + "}"
      ELSIF has_previous_main_num_par_printer(l(p), dlimit) THEN "{" + doublequote + "p" + doublequote + " : " + p + "," + doublequote + "val" + doublequote + " : " + l(p) + "}" ELSE top_num_par_printer(l, p - 1) ENDIF
    ENDCOND
  MEASURE p

top_num_params2string(tep: top_num_params): string =
"[ " + top_num_par_printer(tep, plimit) + "]"
CONVERSION top_num_params2string

main_act2string(ma: main_act): string =
"[ " + main_act_printer(ma, dlimit) + "]"
  CONVERSION main_act2string

dpanel_type2string(dp: dpanel_type): string =
"[ " + d_panel_type_printer(dp, dlimit) + "]"
  CONVERSION dpanel_type2string

patient_config2string(pc: patient_config): string =
     "{" + doublequote + "p_enum_params" + doublequote + ": " + pc`p_enum_params +  ", "+ newline +
       doublequote + "p_num_params" + doublequote + ": " + pc`p_num_params +  ", "+ newline +
    %   "param_set := " + pc`param_set + space +
       doublequote + "p_actions" + doublequote + ": " + pc`p_actions +  ", "+ newline +
       doublequote + "p_av_actions" + doublequote + ": " + pc`p_av_actions +  ", "+ newline +
       doublequote + "p_devices" + doublequote + ": " + pc`p_devices +  ", "+ newline +
       doublequote + "coord_devices" + doublequote + ": " + pc`coord_devices +  ", "+ newline +
       doublequote + "d_available_actions" + doublequote + ": " + pc`d_available_actions + newline + " }"
  CONVERSION patient_config2string


has_previous_coord_db_printer_device_type(l: [ upto(dlimit) -> device_type ], d: device): RECURSIVE bool =
  COND
    d = 0 -> IF l(d) /= no_device THEN TRUE ELSE FALSE ENDIF,
    d > 0 -> IF l(d) /= no_device THEN TRUE ELSE has_previous_coord_db_printer_device_type(l, d-1) ENDIF 
  ENDCOND
  MEASURE d

has_previous_coord_db_printer(l: [upto(plimit) -> patient_config], p: patient): RECURSIVE bool =
  COND
    p = 0 -> IF has_previous_coord_db_printer_device_type(l(p)`p_devices, dlimit) THEN TRUE ELSE FALSE ENDIF,
    p > 0 -> IF has_previous_coord_db_printer_device_type(l(p)`p_devices, dlimit) THEN TRUE ELSE has_previous_coord_db_printer(l, p-1) ENDIF 
  ENDCOND
  MEASURE p

coord_db_printer(l: [upto(plimit) -> patient_config], p: patient): RECURSIVE string =
   COND
      p = 0 -> IF has_previous_coord_db_printer_device_type(l(p)`p_devices, dlimit) THEN "{" + doublequote + "p" + doublequote + " : " + p + "," + doublequote + "val" + doublequote + " : " + l(p) + "}" + newline ELSE "" ENDIF,
      p > 0 -> IF has_previous_coord_db_printer_device_type(l(p)`p_devices, dlimit) and has_previous_coord_db_printer(l, p-1) 
      THEN coord_db_printer(l, p - 1) + ", " + newline + "{" + doublequote + "p" + doublequote + " : " + p + "," + doublequote + "val" + doublequote + " : " + l(p) + "}"
      ELSIF has_previous_coord_db_printer_device_type(l(p)`p_devices, dlimit) THEN "{" + doublequote + "p" + doublequote + " : " + p + "," + doublequote + "val" + doublequote + " : " + l(p) + "}"
      ELSE coord_db_printer(l, p - 1) ENDIF
    ENDCOND
  MEASURE p

