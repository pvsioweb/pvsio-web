  "     " + doublequote + "ent_par" + doublequote + ": " + pdt`ent_par +  ", "+ newline +
  "     " + doublequote + "ent_rel" + doublequote + ": " + pdt`ent_rel +  ", "+ newline +
  "     " + doublequote + "ent_act" + doublequote + ": " + pdt`ent_act +  ", "+ newline +
