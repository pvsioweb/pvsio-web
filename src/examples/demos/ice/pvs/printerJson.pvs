  "   " + doublequote + "id" + doublequote + ": " + ps`id +  ", "+ newline +
  "   " + doublequote + "nde" + doublequote + ": " + ps`nde +  ", "+ newline +
  "   " + doublequote + "pmode" + doublequote + ": " + ps`pmode +  ", "+ newline +
  "   " + doublequote + "emode" + doublequote + ": " + ps`emode +  ", "+ newline +
  "   " + doublequote + "name_buffer" + doublequote + ": " + ps`name_buffer +  ", "+ newline +
  "   " + doublequote + "num_buffer" + doublequote + ": " + ps`num_buffer +  ", "+ newline +
  "   " + doublequote + "disp_focus" + doublequote + ": " + ps`disp_focus +  ", "+ newline +
  "   " + doublequote + "prev_menu_entry" + doublequote + ": " + ps`prev_menu_entry +  ", "+ newline +
  "   " + doublequote + "prev_menu_visible" + doublequote + ": " + ps`prev_menu_visible +  ", "+ newline +
  "   " + doublequote + "p_disp_top" + doublequote + ": " + ps`p_disp_top +  ", "+ newline +
  "   " + doublequote + "p_disp_main" + doublequote + ": " + ps`p_disp_main +  ", "+ newline +
  "   " + doublequote + "p_disp_device" + doublequote + ": " + ps`p_disp_device +  ", "+ newline +
  "   " + doublequote + "p_rules_display" + doublequote + ": " + ps`p_rules_display +  ", "+ newline +
  "   " + doublequote + "patient_panels" + doublequote + ": " + ps`patient_panels +  ", "+ newline +
  "   " + doublequote + "vital_signs" + doublequote + ": " + ps`vital_signs +  ", "+ newline +
  "   " + doublequote + "ip_state" + doublequote + ": " + ps`ip_state + newline +
  "  }" + newline
CONVERSION p_state2string

has_previous_patient_db_printer(l: [ upto(plimit) -> p_state ], p: patient): RECURSIVE bool =
  COND
    p = 0 -> IF l(p)`id /= null_pid THEN TRUE ELSE FALSE ENDIF,
    p > 0 -> IF l(p)`id /= null_pid THEN TRUE ELSE has_previous_patient_db_printer(l, p-1) ENDIF 
  ENDCOND
  MEASURE p

patient_db_printer(l: [ upto(plimit) -> p_state ], p: patient): RECURSIVE string =
COND
  p = 0 -> 
    IF l(p)`id /= null_pid 
    THEN newline + l(p) + ""
    ELSE "" ENDIF,
  p > 0 -> 
    IF l(p)`id /= null_pid AND has_previous_patient_db_printer(l, p-1)
    THEN newline + patient_db_printer(l, p - 1) + "," + l(p)
    ELSIF l(p)`id /= null_pid THEN l(p) ELSE patient_db_printer(l, p - 1) ENDIF
ENDCOND
  MEASURE p


has_previous_patient_connect_printer(l: [ upto(plimit) -> nw_error_type ], p: patient): RECURSIVE bool =
  COND
    p = 0 -> IF l(p) /= not_connected  THEN TRUE ELSE FALSE ENDIF,
    p > 0 -> IF l(p) /= not_connected  THEN TRUE ELSE has_previous_patient_connect_printer(l, p-1) ENDIF 
  ENDCOND
  MEASURE p

patient_connect_printer(l: [ upto(plimit) -> nw_error_type ], p: patient): RECURSIVE string =
COND
  p = 0 -> 
    IF l(p) /= not_connected 
    THEN "" + l(p)
    ELSE "" ENDIF,
  p > 0 -> 
    IF l(p) /= not_connected AND has_previous_patient_connect_printer(l, p-1)
    THEN patient_connect_printer(l, p - 1) + "," + l(p)
    ELSIF l(p) /= not_connected  THEN l(p) ELSE patient_connect_printer(l, p - 1) ENDIF
  ENDCOND
MEASURE p

has_previous_device_connect_printer(l: [ upto(dlimit) -> nw_error_type ], d: device): RECURSIVE bool =
  COND
    d = 0 -> IF l(d) /= not_connected  THEN TRUE ELSE FALSE ENDIF,
    d > 0 -> IF l(d) /= not_connected  THEN TRUE ELSE has_previous_device_connect_printer(l, d-1) ENDIF 
  ENDCOND
  MEASURE d

device_connect_printer(l: [ upto(dlimit) -> nw_error_type ], d: device): RECURSIVE string =
  COND
    d = 0 -> 
      IF l(d) /= not_connected 
      THEN "" + l(d)
      ELSE "" ENDIF,
    d > 0 -> 
      IF l(d) /= not_connected AND has_previous_device_connect_printer(l, d-1)
      THEN device_connect_printer(l, d - 1) + "," + l(d)
      ELSIF l(d) /= not_connected  THEN l(d) ELSE device_connect_printer(l, d - 1) ENDIF
  ENDCOND
MEASURE d

device_connect_type2string(dc: device_connect_type): string =
"[ " + device_connect_printer(dc, dlimit) + "]"
  CONVERSION device_connect_type2string
  
patient_device_connect_printer(l: [ upto(plimit) -> device_connect_type ], p: patient): RECURSIVE string =
COND
      p = 0 -> "" + l(p),
      p > 0 -> patient_device_connect_printer(l, p - 1) +  "," + l(p)
ENDCOND
  MEASURE p


