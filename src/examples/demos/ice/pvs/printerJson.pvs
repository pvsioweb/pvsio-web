menu_set2string(ms: menu_set): string =
  LET json = "[",
      json = json + IF ms(no_action) THEN doublequote + "no_action" + doublequote ELSE "" ENDIF,
      json = json + IF ms(no_action) AND (ms(delete) OR ms(cursor_up) OR 
                       ms(cursor_down) OR ms(select) OR ms(enter) OR ms(top) OR 
                       ms(main) OR ms(patient) OR ms(device) OR ms(region) OR 
                       ms(rule) OR ms(constraint) OR ms(edit) OR ms(clear) OR 
                       ms(display) OR ms(parameter) OR ms(action) OR ms(relation) OR ms(num_value) OR 
                       ms(enum_value) OR ms(escape) OR ms(pump) OR ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(delete) THEN doublequote + "delete" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(delete) AND (ms(cursor_up) OR ms(cursor_down) OR
                       ms(select) OR ms(enter) OR ms(top) OR ms(main) OR ms(patient) OR 
                       ms(device) OR  ms(region) OR ms(rule) OR ms(constraint) OR 
                       ms(edit) OR ms(clear) OR ms(display) OR  ms(parameter) OR 
                       ms(action) OR ms(relation) OR ms(num_value) OR  ms(enum_value) OR ms(escape) OR ms(pump) OR 
                       ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(cursor_up) THEN doublequote + "cursor_up" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(cursor_up) AND (ms(cursor_down) OR ms(select) OR ms(enter) OR 
                       ms(top) OR ms(main) OR ms(patient) OR ms(device) OR ms(region) OR 
                       ms(rule) OR ms(constraint) OR  ms(edit) OR ms(clear) OR 
                       ms(display) OR  ms(parameter) OR ms(action) OR ms(relation) OR ms(num_value) OR 
                       ms(enum_value) OR ms(escape) OR ms(pump) OR ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(cursor_down) THEN doublequote + "cursor_down" + doublequote ELSE "" ENDIF,
      json = json + IF ms(cursor_down) AND (ms(select) OR ms(enter) OR ms(top) OR
                       ms(main) OR ms(patient) OR ms(device) OR  ms(region) OR ms(rule) OR 
                       ms(constraint) OR ms(edit) OR ms(clear) OR ms(display) OR 
                       ms(parameter) OR ms(action) OR ms(relation) OR ms(num_value) OR ms(enum_value) OR 
                       ms(escape) OR ms(pump) OR ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(select) THEN doublequote + "select" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(select) AND (ms(enter) OR ms(top) OR ms(main) OR ms(patient) OR 
                       ms(device) OR ms(region) OR ms(rule) OR ms(constraint) OR 
                       ms(edit) OR ms(clear) OR ms(display) OR ms(parameter) OR 
                       ms(action) OR ms(relation) OR ms(num_value) OR ms(enum_value) OR ms(escape) OR ms(pump) OR 
                       ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(enter) THEN doublequote + "enter" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(enter) AND (ms(top) OR ms(main) OR ms(patient) OR ms(device) OR 
                       ms(region) OR ms(rule) OR ms(constraint) OR ms(edit) OR 
                       ms(clear) OR ms(display) OR ms(parameter) OR ms(action) OR ms(relation) OR 
                       ms(num_value) OR  ms(enum_value) OR ms(escape) OR ms(pump) OR ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(top) THEN doublequote + "top" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(top) AND (ms(main) OR ms(patient) OR ms(device) OR 
                       ms(region) OR ms(rule) OR ms(constraint) OR ms(edit) OR 
                       ms(clear) OR ms(display) OR ms(parameter) OR ms(action) OR ms(relation) OR 
                       ms(num_value) OR ms(enum_value) OR ms(escape) OR ms(pump) OR ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(main) THEN doublequote + "main" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(main) AND (ms(patient) OR ms(device) OR ms(region) OR 
                       ms(rule) OR ms(constraint) OR ms(edit) OR ms(clear) OR 
                       ms(display) OR ms(parameter) OR ms(action) OR ms(relation) OR ms(num_value) OR 
                       ms(enum_value) OR ms(escape) OR ms(pump) OR ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(patient) THEN doublequote + "patient" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(patient) AND (ms(device) OR ms(region) OR ms(rule) OR 
                       ms(constraint) OR ms(edit) OR ms(clear) OR ms(display) OR 
                       ms(parameter) OR ms(action) OR ms(relation) OR ms(num_value) OR 
                       ms(enum_value) OR ms(escape) OR ms(pump) OR ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(device) THEN doublequote + "device" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(device) AND (ms(region) OR ms(rule) OR ms(constraint) OR 
                       ms(edit) OR ms(clear) OR ms(display) OR  ms(parameter) OR 
                       ms(action) OR ms(relation) OR ms(num_value) OR ms(enum_value) OR ms(escape) OR ms(pump) OR 
                       ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(region) THEN doublequote + "region" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(region) AND (ms(rule) OR ms(constraint) OR ms(edit) OR 
                       ms(clear) OR ms(display) OR ms(parameter) OR ms(action) OR ms(relation) OR 
                       ms(num_value) OR ms(enum_value) OR ms(escape) OR ms(pump) OR ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(rule) THEN doublequote + "rule" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(rule) AND (ms(constraint) OR ms(edit) OR ms(clear) OR 
                       ms(display) OR ms(parameter) OR ms(action) OR ms(relation) OR ms(num_value) OR 
                       ms(enum_value) OR ms(escape) OR ms(pump) OR ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(constraint) THEN doublequote + "constraint" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(constraint) AND (ms(edit) OR ms(clear) OR ms(display) OR 
                       ms(parameter) OR ms(action) OR ms(relation) OR ms(num_value) OR 
                       ms(enum_value) OR ms(escape) OR ms(pump) OR ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(edit) THEN doublequote + "edit" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(edit) AND (ms(clear) OR ms(display) OR ms(parameter) OR ms(action) OR
                       ms(relation) OR ms(num_value) OR ms(enum_value) OR ms(escape) OR ms(pump) OR 
                       ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(clear) THEN doublequote + "clear" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(clear) AND (ms(display) OR ms(parameter) OR ms(action) OR ms(relation) OR 
                       ms(num_value) OR ms(enum_value) OR ms(escape) OR ms(pump) OR ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(display) THEN doublequote + "display" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(display) AND (ms(parameter) OR ms(action) OR ms(relation) OR 
                       ms(num_value) OR ms(enum_value) OR ms(escape) OR ms(pump) OR ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(parameter) THEN doublequote + "parameter" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(parameter) AND (ms(action) OR ms(relation) OR ms(num_value) OR 
                       ms(enum_value) OR ms(escape) OR ms(pump) OR ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(action) THEN doublequote + "action" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(action) AND (ms(relation) OR ms(num_value) OR 
                       ms(enum_value) OR ms(escape) OR ms(pump) OR ms(vs_device))
                    THEN ", " ELSE "" ENDIF,            
      json = json + IF ms(relation) THEN doublequote + "relation" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(relation) AND (ms(num_value) OR ms(enum_value) OR ms(escape) OR ms(pump) OR 
                       ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(num_value) THEN doublequote + "num_value" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(num_value) AND (ms(enum_value) OR ms(pump) OR ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(enum_value) THEN doublequote + "enum_value" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(enum_value) AND (ms(escape) OR ms(pump) OR ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(escape) THEN doublequote + "escape" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(escape) AND (ms(pump) OR ms(vs_device))
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(pump) THEN doublequote + "pump" + doublequote ELSE ""  ENDIF,
      json = json + IF ms(pump) AND ms(vs_device)
                    THEN ", " ELSE "" ENDIF,
      json = json + IF ms(vs_device) THEN doublequote + "vs_device" + doublequote ELSE ""  ENDIF
  IN json + "]"
  CONVERSION menu_set2string

value_type2string(p: value_type): string =
   COND
    p = numeral -> doublequote + "numeral" + doublequote,
    p = enumerated     -> doublequote + "enumerated" + doublequote,
    p = empty -> doublequote + "empty" + doublequote
    ENDCOND
  CONVERSION value_type2string

par2string(a: par): string =
   COND
    a = rte -> doublequote + "rte" + doublequote,
    a = vtb     -> doublequote + "vtb" + doublequote,
    a = tme  -> doublequote + "tme" + doublequote,
    a = dpm -> doublequote + "dpm" + doublequote,
    a = mde     -> doublequote + "mde" + doublequote,
    a = er  -> doublequote + "er" + doublequote,
    a = hrte -> doublequote + "hrte" + doublequote,
    a = blpl -> doublequote + "blpl" + doublequote,
    a = blph -> doublequote + "blph" + doublequote,
    a = sp -> doublequote + "sp" + doublequote,
    a = rkrt -> doublequote + "rkrt" + doublequote,
    a = ptmp -> doublequote + "ptmp" + doublequote
    ENDCOND
  CONVERSION par2string



parset2string(ps: parset): string =
LET ans = "[ ",
      ans = IF ps(rte) THEN ans + doublequote + "rte" + doublequote ELSE ans ENDIF,
      ans = ans + IF ps(rte) AND (ps(vtb) OR ps(tme) OR ps(dpm) OR 
                       ps(mde) OR ps(er) OR ps(hrte) OR 
                       ps(blpl) OR ps(blph) OR ps(sp) OR ps(rkrt) OR ps(ptmp))
                    THEN ", " ELSE "" ENDIF,
      ans = IF ps(vtb) THEN ans + doublequote + "vtb" + doublequote ELSE ans ENDIF,
      ans = ans + IF ps(vtb) AND (ps(tme) OR ps(dpm) OR 
                       ps(mde) OR ps(er) OR ps(hrte) OR 
                       ps(blpl) OR ps(blph) OR ps(sp) OR ps(rkrt) OR ps(ptmp))
                    THEN ", " ELSE "" ENDIF,
      ans = IF ps(tme) THEN ans + doublequote + "tme" + doublequote ELSE ans ENDIF,
      ans = ans + IF ps(tme) AND (ps(dpm) OR 
                       ps(mde) OR ps(er) OR ps(hrte) OR 
                       ps(blpl) OR ps(blph) OR ps(sp) OR ps(rkrt) OR ps(ptmp))
                    THEN ", " ELSE "" ENDIF,
      ans = IF ps(dpm) THEN ans + doublequote + "dpm" + doublequote ELSE ans ENDIF,
      ans = ans + IF ps(dpm) AND (ps(mde) OR ps(er) OR ps(hrte) OR 
                       ps(blpl) OR ps(blph) OR ps(sp) OR ps(rkrt) OR ps(ptmp))
                    THEN ", " ELSE "" ENDIF,
      ans = IF ps(mde) THEN ans + doublequote + "mde" + doublequote ELSE ans ENDIF,
      ans = ans + IF ps(mde) AND (ps(er) OR ps(hrte) OR 
                       ps(blpl) OR ps(blph) OR ps(sp) OR ps(rkrt) OR ps(ptmp))
                    THEN ", " ELSE "" ENDIF,
      ans = IF ps(er) THEN ans + doublequote + "er" + doublequote ELSE ans ENDIF,
      ans = ans + IF ps(er) AND (ps(hrte) OR 
                       ps(blpl) OR ps(blph) OR ps(sp) OR ps(rkrt) OR ps(ptmp))
                    THEN ", " ELSE "" ENDIF,
      ans = IF ps(hrte) THEN ans + doublequote + "hrte" + doublequote ELSE ans ENDIF,
      ans = ans + IF ps(hrte) AND (ps(blpl) OR ps(blph) OR ps(sp) OR ps(rkrt) OR ps(ptmp))
                    THEN ", " ELSE "" ENDIF,
      ans = IF ps(blpl) THEN ans + doublequote + "blpl" + doublequote ELSE ans ENDIF,
      ans = ans + IF ps(blpl) AND (ps(blph) OR ps(sp) OR ps(rkrt) OR ps(ptmp))
                    THEN ", " ELSE "" ENDIF,
      ans = IF ps(blph) THEN ans + doublequote + "blph" + doublequote ELSE ans ENDIF,
      ans = ans + IF ps(blph) AND (ps(sp) OR ps(rkrt) OR ps(ptmp))
                    THEN ", " ELSE "" ENDIF,
      ans = IF ps(sp) THEN ans + doublequote + "sp" + doublequote ELSE ans ENDIF,
      ans = ans + IF ps(sp) AND (ps(rkrt) OR ps(ptmp))
                    THEN ", " ELSE "" ENDIF,
      ans = IF ps(rkrt) THEN ans + doublequote + "rkrt" + doublequote ELSE ans ENDIF,
      ans = ans + IF ps(rkrt) AND (ps(ptmp))
                    THEN ", " ELSE "" ENDIF,
      ans = IF ps(ptmp) THEN ans + doublequote + "ptmp" + doublequote ELSE ans ENDIF
   IN ans + " ]"
  CONVERSION parset2string

enum2string(e: enum): string =
   COND
    e = xoff -> doublequote + "xoff" + doublequote,
    e = xpause     -> doublequote + "xpause" + doublequote,
    e = xinfuse  -> doublequote + "xinfuse" + doublequote,
    e = xdblank -> doublequote + "xdblank" + doublequote,
    e = xmainmenu -> doublequote + "xmainmenu" + doublequote,
    e = xdvtbi -> doublequote + "xdvtbi" + doublequote,
    e = xdrate -> doublequote + "xdrate" + doublequote,
    e = xdtime -> doublequote + "xdtime" + doublequote,
    e = xdinfusing -> doublequote + "xdinfusing" + doublequote,
    e = xdalarm -> doublequote + "xdalarm" + doublequote,
    e = xdkvo -> doublequote + "xdkvo" + doublequote,
    e = xopen -> doublequote + "xopen" + doublequote,
    e = xclosed -> doublequote + "xclosed" + doublequote,
    e = xrte -> doublequote + "xrte" + doublequote,
    e = xtme -> doublequote + "xtme" + doublequote,
    e = xisconnected -> doublequote + "xisconnected" + doublequote,
    e = xactive -> doublequote + "xactive" + doublequote,
    e = xnumeral -> doublequote + "xnumeral" + doublequote,
    e = xenumerated -> doublequote + "xenumerated" + doublequote,
    e = xnilval -> doublequote + "xnilval" + doublequote,
    e = xalarm -> doublequote + "xalarm" + doublequote,
    e = xok -> doublequote + "xok" + doublequote
    ENDCOND
CONVERSION enum2string

enumset2string(es: enumset): string =
 LET ans = "[ ",
      ans = IF es(xoff) THEN ans + doublequote + "xoff" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xoff) AND (es(xpause) OR es(xinfuse) OR es(xdblank) OR 
                       es(xmainmenu) OR es(xdvtbi) OR es(xdrate) OR 
                       es(xdtime) OR es(xdinfusing) OR es(xdalarm) OR es(xdkvo) OR
                       es(xopen) OR es(xclosed) OR es(xrte) OR es(xtme) OR es(xisconnected) OR
                       es(xactive) OR es(xnumeral) OR es(xenumerated) OR es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xpause) THEN ans + doublequote + "xpause" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xpause) AND (es(xinfuse) OR es(xdblank) OR 
                       es(xmainmenu) OR es(xdvtbi) OR es(xdrate) OR 
                       es(xdtime) OR es(xdinfusing) OR es(xdalarm) OR es(xdkvo) OR
                       es(xopen) OR es(xclosed) OR es(xrte) OR es(xtme) OR es(xisconnected) OR
                       es(xactive) OR es(xnumeral) OR es(xenumerated) OR es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xinfuse) THEN ans + doublequote + "xinfuse" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xinfuse) AND (es(xdblank) OR 
                       es(xmainmenu) OR es(xdvtbi) OR es(xdrate) OR 
                       es(xdtime) OR es(xdinfusing) OR es(xdalarm) OR es(xdkvo) OR
                       es(xopen) OR es(xclosed) OR es(xrte) OR es(xtme) OR es(xisconnected) OR
                       es(xactive) OR es(xnumeral) OR es(xenumerated) OR es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xdblank) THEN ans + doublequote + "xdblank" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xdblank) AND (es(xmainmenu) OR es(xdvtbi) OR es(xdrate) OR 
                       es(xdtime) OR es(xdinfusing) OR es(xdalarm) OR es(xdkvo) OR
                       es(xopen) OR es(xclosed) OR es(xrte) OR es(xtme) OR es(xisconnected) OR
                       es(xactive) OR es(xnumeral) OR es(xenumerated) OR es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xmainmenu) THEN ans + doublequote + "xmainmenu" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xmainmenu) AND (es(xdvtbi) OR es(xdrate) OR 
                       es(xdtime) OR es(xdinfusing) OR es(xdalarm) OR es(xdkvo) OR
                       es(xopen) OR es(xclosed) OR es(xrte) OR es(xtme) OR es(xisconnected) OR
                       es(xactive) OR es(xnumeral) OR es(xenumerated) OR es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xdvtbi) THEN ans + doublequote + "xdvtbi" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xdvtbi) AND (es(xdrate) OR 
                       es(xdtime) OR es(xdinfusing) OR es(xdalarm) OR es(xdkvo) OR
                       es(xopen) OR es(xclosed) OR es(xrte) OR es(xtme) OR es(xisconnected) OR
                       es(xactive) OR es(xnumeral) OR es(xenumerated) OR es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xdrate) THEN ans + doublequote + "xdrate" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xdrate) AND (es(xdtime) OR es(xdinfusing) OR es(xdalarm) OR es(xdkvo) OR
                       es(xopen) OR es(xclosed) OR es(xrte) OR es(xtme) OR es(xisconnected) OR
                       es(xactive) OR es(xnumeral) OR es(xenumerated) OR es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xdtime) THEN ans + doublequote + "xdtime" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xdtime) AND (es(xdinfusing) OR es(xdalarm) OR es(xdkvo) OR
                       es(xopen) OR es(xclosed) OR es(xrte) OR es(xtme) OR es(xisconnected) OR
                       es(xactive) OR es(xnumeral) OR es(xenumerated) OR es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xdinfusing) THEN ans + doublequote + "xdinfusing" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xdinfusing) AND (es(xdalarm) OR es(xdkvo) OR
                       es(xopen) OR es(xclosed) OR es(xrte) OR es(xtme) OR es(xisconnected) OR
                       es(xactive) OR es(xnumeral) OR es(xenumerated) OR es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xdalarm) THEN ans + doublequote + "xdalarm" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xdalarm) AND (es(xdkvo) OR
                       es(xopen) OR es(xclosed) OR es(xrte) OR es(xtme) OR es(xisconnected) OR
                       es(xactive) OR es(xnumeral) OR es(xenumerated) OR es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xdkvo) THEN ans + doublequote + "xdkvo" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xdkvo) AND (es(xopen) OR es(xclosed) OR es(xrte) OR es(xtme) OR es(xisconnected) OR
                       es(xactive) OR es(xnumeral) OR es(xenumerated) OR es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xopen) THEN ans + doublequote + "xopen" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xopen) AND (es(xclosed) OR es(xrte) OR es(xtme) OR es(xisconnected) OR
                       es(xactive) OR es(xnumeral) OR es(xenumerated) OR es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xclosed) THEN ans + doublequote + "xclosed" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xclosed) AND (es(xrte) OR es(xtme) OR es(xisconnected) OR
                       es(xactive) OR es(xnumeral) OR es(xenumerated) OR es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xrte) THEN ans + doublequote + "xrte" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xrte) AND (es(xtme) OR es(xisconnected) OR
                       es(xactive) OR es(xnumeral) OR es(xenumerated) OR es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xtme) THEN ans + doublequote + "xtme" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xtme) AND (es(xisconnected) OR
                       es(xactive) OR es(xnumeral) OR es(xenumerated) OR es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xisconnected) THEN ans + doublequote + "xisconnected" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xisconnected) AND (es(xactive) OR es(xnumeral) OR es(xenumerated) OR es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xactive) THEN ans + doublequote + "xactive" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xactive) AND (es(xnumeral) OR es(xenumerated) OR es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xnumeral) THEN ans + doublequote + "xnumeral" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xnumeral) AND (es(xenumerated) OR es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xenumerated) THEN ans + doublequote + "xenumerated" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xenumerated) AND (es(xnilval) OR es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xnilval) THEN ans + doublequote + "xnilval" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xnilval) AND (es(xalarm) OR es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xalarm) THEN ans + doublequote + "xalarm" + doublequote ELSE ans ENDIF,
      ans = ans + IF es(xalarm) AND (es(xok))
                    THEN ", " ELSE "" ENDIF,
      ans = IF es(xok) THEN ans + doublequote + "xok" + doublequote ELSE ans ENDIF
   IN ans + " ]"
  CONVERSION enumset2string


msghdr2string(mh: msg_hdr_type): string =
COND
    mh = nomsg -> doublequote + "nomsg" + doublequote,
    mh = tmmsg -> doublequote + "tmmsg" + doublequote,
    mh = pmmsg -> doublequote + "pmmsg" + doublequote,
    mh = mmmsg -> doublequote + "mmmsg" + doublequote,
    mh = updmsg -> doublequote + "updmsg" + doublequote,
    mh = actmsg -> doublequote + "actmsg" + doublequote,
    mh = cnstmsg -> doublequote + "cnstmsg" + doublequote
ENDCOND
  CONVERSION msghdr2string

b_status2string(bs: b_status): string =
COND
    bs = full -> doublequote + "full" + doublequote,
    bs = empty -> doublequote + "empty" + doublequote,
    bs = functioning -> doublequote + "functioning" + doublequote
ENDCOND
  CONVERSION b_status2string

nw_error_type2string(ne: nw_error_type): string =
COND
    ne = clear -> doublequote + "clear" + doublequote,
    ne = not_connected -> doublequote + "not_connected" + doublequote,
    ne = no_msg -> doublequote + "no_msg" + doublequote,
    ne = empty_q -> doublequote + "empty_q" + doublequote,
    ne = full_q -> doublequote + "full_q" + doublequote,
    ne = spurious_action -> doublequote + "spurious_action" + doublequote
 ENDCOND
  CONVERSION nw_error_type2string

network_error_type2string(nwe: network_error_type): string =
"{" + doublequote + "nsource" + doublequote + ": " + nwe`nsource +  ", "+ space +
       doublequote + "ndest" + doublequote + ": " + nwe`ndest +  ", "+ space +
       doublequote + "chan_error" + doublequote + ": " + nwe`chan_error + " }"
CONVERSION network_error_type2string

num_parameter2string(np: num_parameter): string =
LET ans = "{ ",
      ans = IF (np(rte) /= null_value)
            THEN ans + "" + rte + ": " +  np(rte) ELSE ans ENDIF,
      ans = IF (np(rte) /= null_value) AND ((np(vtb) /= null_value) OR (np(tme) /= null_value) OR 
            (np(hrte) /= null_value) OR (np(blpl) /= null_value) OR (np(blph) /= null_value) OR (np(sp) /= null_value) OR
            (np(rkrt) /= null_value) OR (np(ptmp) /= null_value)) THEN ans + "," + space ELSE ans ENDIF,
      ans = IF (np(vtb) /= null_value)
            THEN ans + "" + vtb + ": " +  np(vtb) ELSE ans ENDIF,
      ans = IF (np(vtb) /= null_value) AND ((np(tme) /= null_value) OR 
            (np(hrte) /= null_value) OR (np(blpl) /= null_value) OR (np(blph) /= null_value) OR (np(sp) /= null_value) OR
            (np(rkrt) /= null_value) OR (np(ptmp) /= null_value)) THEN ans + "," + space ELSE ans ENDIF,
      ans = IF (np(tme) /= null_value)
            THEN ans + "" + tme + ": " +  np(tme) ELSE ans ENDIF,
      ans = IF (np(tme) /= null_value) AND ((np(hrte) /= null_value) OR (np(blpl) /= null_value) OR (np(blph) /= null_value) OR (np(sp) /= null_value) OR
            (np(rkrt) /= null_value) OR (np(ptmp) /= null_value)) THEN ans + "," + space ELSE ans ENDIF,
      ans = IF (np(hrte) /= null_value)
            THEN ans + "" + hrte + ": " +  np(hrte) ELSE ans ENDIF,
      ans = IF (np(hrte) /= null_value) AND ((np(blpl) /= null_value) OR (np(blph) /= null_value) OR (np(sp) /= null_value) OR
            (np(rkrt) /= null_value) OR (np(ptmp) /= null_value)) THEN ans + "," + space ELSE ans ENDIF,
      ans = IF (np(blpl) /= null_value)
            THEN ans + "" + blpl + ": " +  np(blpl) ELSE ans ENDIF,
      ans = IF (np(blpl) /= null_value) AND ((np(blph) /= null_value) OR (np(sp) /= null_value) OR
            (np(rkrt) /= null_value) OR (np(ptmp) /= null_value)) THEN ans + "," + space ELSE ans ENDIF,
      ans = IF (np(blph) /= null_value)
            THEN ans + "" + blph + ": " +  np(blph) ELSE ans ENDIF,
      ans = IF (np(blph) /= null_value) AND ((np(sp) /= null_value) OR
            (np(rkrt) /= null_value) OR (np(ptmp) /= null_value)) THEN ans + "," + space ELSE ans ENDIF,
      ans = IF (np(sp) /= null_value)
            THEN ans + "" + sp + ": " +  np(sp) ELSE ans ENDIF,
      ans = IF (np(sp) /= null_value) AND ((np(rkrt) /= null_value) OR (np(ptmp) /= null_value)) THEN ans + "," + space ELSE ans ENDIF,
      ans = IF (np(rkrt) /= null_value)
            THEN ans + "" + rkrt + ": " +  np(rkrt) ELSE ans ENDIF,
      ans = IF (np(rkrt) /= null_value) AND ((np(ptmp) /= null_value)) THEN ans + "," + space ELSE ans ENDIF,
      ans = IF (np(ptmp) /= null_value)
            THEN ans + "" + ptmp + ": " +  np(ptmp) + "" + space ELSE ans ENDIF
   IN ans + " }"
  CONVERSION num_parameter2string


enum_parameter2string(ep: enum_parameter): string =
LET ans = "{ ",
      ans = IF (ep(dpm) /= xnilval)
            THEN ans + "" + dpm + ": " +  ep(dpm) ELSE ans ENDIF,
      ans = IF (ep(dpm) /= xnilval) AND ((ep(mde) /= xnilval) OR (ep(er) /= xnilval)) THEN ans + "," + space ELSE ans ENDIF,
      ans = IF (ep(mde) /= xnilval) THEN ans + "" + mde + ": " +  ep(mde) + space ELSE ans ENDIF,
      ans = IF (ep(mde) /= xnilval) AND ((ep(er) /= xnilval)) THEN ans + "," + space ELSE ans ENDIF,
      ans = IF (ep(er) /= xnilval)
            THEN ans + "" + er + ": " +  ep(er) + "" + space ELSE ans ENDIF
   IN ans + " }"
  CONVERSION enum_parameter2string



panel2string(pa: panel): string =
  "{" + newline + 
  doublequote + "pars" + doublequote + ": " + pa`pars +  ", "+ newline +
  doublequote + "enum_disp" + doublequote + ": " + pa`enum_disp +  ", "+ newline +
  doublequote + "num_disp" + doublequote + ": " + pa`num_disp +  ", "+ newline +
  doublequote + "cmds" + doublequote + ": " + pa`cmds + newline +
  "      }"
CONVERSION panel2string

v_state2string(vs: v_state): string =
  "{" + newline + 
  doublequote + "dev" + doublequote + ": " + vs`dev +  ", "+ newline +
  doublequote + "nde" + doublequote + ": " + vs`nde +  ", "+ newline +
  doublequote + "power" + doublequote + ": " + vs`power +  ", "+ newline +
  doublequote + "HR" + doublequote + ": " + vs`HR +  ", "+ newline +
  doublequote + "BPL" + doublequote + ": " + vs`BPL +  ", "+ newline +
  doublequote + "BPH" + doublequote + ": " + vs`BPH +  ", "+ newline +
  doublequote + "SPO2" + doublequote + ": " + vs`SPO2 +  ", "+ newline +
  doublequote + "RR" + doublequote + ": " + vs`RR +  ", "+ newline +
  doublequote + "temp" + doublequote + ": " + vs`temp +  ", "+ newline +
  doublequote + "pan" + doublequote + ": " + vs`pan + ", "+ newline + 
  doublequote + "vs_error" + doublequote + ": " + vs`vs_error + newline + 
  "    }"
CONVERSION v_state2string



pan_message_type2string(pa: pan_message_type): string =
   "{" + doublequote + "mhdr" + doublequote + ": " + pa`mhdr +  ", " + newline +
       doublequote + "pat_nd" + doublequote + ": " + pa`pat_nd + ", " + newline +
       doublequote + "msg_nd" + doublequote + ": " + pa`msg_nd + ", " + newline +
       doublequote + "pan" + doublequote + ": " + pa`pan + " }"
  CONVERSION pan_message_type2string

act_msg_type2string(aa: act_message_type): string =
   "{" + doublequote + "mhdr" + doublequote + ": " + aa`mhdr + ", " + newline +
       doublequote + "pat_nd" + doublequote + ": " + aa`pat_nd + ", " + newline +
       doublequote + "msg_nd" + doublequote + ": " + aa`msg_nd + ", " + newline +
       doublequote + "act" + doublequote + ": " + aa`act + " }"
  CONVERSION act_msg_type2string


has_previous_node(l: [ upto(nlimit) -> bool ], n: node): RECURSIVE bool =
  COND
    n = 0 -> IF l(n) THEN TRUE ELSE FALSE ENDIF,
    n > 0 -> IF l(n) THEN TRUE ELSE has_previous_node(l, n-1) ENDIF 
  ENDCOND
  MEASURE n

  node_printer_bool(l: [ upto(nlimit) -> bool ], n: node): RECURSIVE string =
    COND
      n = 0 -> IF l(n) THEN doublequote + "node(" + n + ")" + doublequote  ELSE "" ENDIF,
      n > 0 -> IF l(n) AND has_previous_node(l, n - 1) THEN node_printer_bool(l, n - 1) +  ", " + doublequote + "node(" + n + ")" + doublequote  ELSIF l(n) THEN doublequote + "node(" + n + ")" + doublequote + node_printer_bool(l, n - 1) ELSE node_printer_bool(l, n - 1) ENDIF
    ENDCOND
  MEASURE n

has_previous_device(l: [ upto(nlimit) -> bool ], d: device): RECURSIVE bool =
  COND
    d = 0 -> IF l(d) THEN TRUE ELSE FALSE ENDIF,
    d > 0 -> IF l(d) THEN TRUE ELSE has_previous_device(l, d - 1) ENDIF 
  ENDCOND
  MEASURE d

 device_printer_bool(l: [ upto(dlimit) -> bool ], d: device): RECURSIVE string =
    COND
      d = 0 -> IF l(d) THEN doublequote + "device(" + d + ")" + doublequote ELSE "" ENDIF,
      d > 0 -> IF l(d) and has_previous_device(l, d - 1) THEN device_printer_bool(l, d - 1) + newline + ", "  + doublequote + "device(" + d + ")" + doublequote ELSIF l(d) THEN doublequote + "device(" + d + ")" + doublequote + device_printer_bool(l, d - 1) + newline ELSE device_printer_bool(l, d - 1) ENDIF
    ENDCOND
  MEASURE d

has_previous_devs_printer_type(l: [ upto(nlimit) -> device_type ], n: node): RECURSIVE bool =
  COND
    n = 0 -> IF l(n) /= no_device THEN TRUE ELSE FALSE ENDIF,
    n > 0 -> IF l(n) /= no_device THEN TRUE ELSE has_previous_devs_printer_type(l, n-1) ENDIF 
  ENDCOND
  MEASURE n


devs_printer_type(l: [ upto(nlimit) -> device_type ], n: node): RECURSIVE string =
    COND
      n = 0 -> IF l(n) /= no_device THEN "{" + doublequote + "d" + doublequote + " : " + n + "," + doublequote + "val" + doublequote + " : " + l(n) + "}"
                     ELSE " " ENDIF,
      n > 0 -> IF l(n) /= no_device AND has_previous_devs_printer_type(l, n - 1) THEN devs_printer_type(l, n - 1) + ", " + "{" + doublequote + "d" + doublequote + " : " + n + "," + doublequote + "val" + doublequote + " : " + l(n) + "}"
               ELSIF l(n) /= no_device THEN "{" + doublequote + "d" + doublequote + " : " + n + "," + doublequote + "val" + doublequote + " : " + l(n) + "}" ELSE devs_printer_type(l, n - 1) ENDIF
    ENDCOND
  MEASURE n

has_previous_patient(l: [ upto(nlimit) -> bool ], p: patient): RECURSIVE bool =
  COND
    p = 0 -> IF l(p) THEN TRUE ELSE FALSE ENDIF,
    p > 0 -> IF l(p) THEN TRUE ELSE has_previous_patient(l, p-1) ENDIF 
  ENDCOND
  MEASURE p

patient_printer_bool(l: [ upto(plimit) -> bool ], p: patient): RECURSIVE string =
    COND
      p = 0 -> IF l(p) THEN "" + p + "" ELSE " " ENDIF,
      p > 0 -> IF l(p) and has_previous_patient(l, p - 1) THEN patient_printer_bool(l, p - 1) + ", " + newline + p ELSIF l(p) THEN p + newline + patient_printer_bool(l, p - 1) ELSE patient_printer_bool(l, p - 1) ENDIF
    ENDCOND
  MEASURE p


has_previous_connected_printer(l: [upto(nlimit), upto(nlimit) -> bool], n1, n2: node): RECURSIVE bool =
  COND
    n1 = 0 -> IF l(n1, n2) THEN TRUE ELSE FALSE ENDIF,
    n1 > 0 -> IF l(n1, n2) THEN TRUE ELSE has_previous_connected_printer(l, n1-1, n2) ENDIF 
  ENDCOND
  MEASURE n1

connected_printer_bool(l: [upto(nlimit), upto(nlimit) -> bool], n1, n2: node)
  : RECURSIVE string =
COND
   n1 = 0 -> IF l(n1, n2)
             THEN "" + doublequote + "nodes linked <" + n1 + "," + n2 + ">" + doublequote ELSE "" ENDIF,
   n1 > 0 -> IF l(n1, n2) AND has_previous_connected_printer(l, n1-1, n2)
             THEN "" + connected_printer_bool(l, n1-1, n2) + ", " + doublequote + "nodes linked <" + n1 + "," + n2 + ">" + doublequote
              ELSIF l(n1, n2) THEN doublequote + "nodes linked <" + n1 + "," + n2 + ">" + doublequote ELSE connected_printer_bool(l, n1-1, n2) ENDIF
ENDCOND
MEASURE n1

nodes_link_printer(l: [upto(nlimit), upto(nlimit) -> bool], n1, n2: node):
                             RECURSIVE string =
COND
  n2 = 0 -> "[" + connected_printer_bool(l, n1, n2) + "]",
  n2 > 0 -> nodes_link_printer(l, n1, n2-1) + ", [" + connected_printer_bool(l, n1, n2) + "]"
ENDCOND
MEASURE n2

connected2string(c: connected): string =
"[" + nodes_link_printer(c, nlimit, nlimit) + "" + "]"
 CONVERSION connected2string

node_to_integer_printer(l: [ upto(nlimit) -> integer ], n: node, nv: integer): RECURSIVE string =
    COND
      n = 0 -> IF l(n) /= nv THEN "" + l(n) ELSE
               "" ENDIF,
      n > 0 -> IF l(n) /= nv
               THEN node_to_integer_printer(l, n - 1, nv) + "," + newline + l(n)
	       ELSE node_to_integer_printer(l, n - 1, nv) ENDIF
    ENDCOND
  MEASURE n


patient_to_device2string(pd: patient_to_device): string =
 "{" + doublequote + "pat" + doublequote + ": " + pd`pat + "," + newline +
    doublequote + "dev" + doublequote + ": " + pd`dev + newline + " }"
  CONVERSION patient_to_device2string

dev_act_type2string(da: dev_act_type): string =
"{" + doublequote + "dev" + doublequote + ": " + da`dev + "," + newline +
    doublequote + "act" + doublequote + ": " + da`act + newline + " }"
  CONVERSION dev_act_type2string

has_previous_node_to_pd_printer(l: [ upto(nlimit) -> patient_to_device ], n: node): RECURSIVE bool =
  COND
    n = 0 -> IF l(n)`pat /= p_null THEN TRUE ELSE FALSE ENDIF,
    n > 0 -> IF l(n)`pat /= p_null THEN TRUE ELSE has_previous_node_to_pd_printer(l, n-1) ENDIF 
  ENDCOND
  MEASURE n

node_to_pd_printer(l: [ upto(nlimit) -> patient_to_device ], n: node): RECURSIVE string =
    COND
      n = 0 -> IF l(n)`pat /= p_null THEN "{" + doublequote + "node" + doublequote + ":" + n + "," + doublequote + "pd" + doublequote + ":" + l(n) + "}" ELSE "" ENDIF,
      n > 0 -> IF l(n)`pat /= p_null AND has_previous_node_to_pd_printer(l, n-1) THEN node_to_pd_printer(l, n - 1) + "," + newline + "{" + doublequote + "node" + doublequote + ":" + n + "," + doublequote + "pd" + doublequote + ":" + l(n) + "}" ELSIF l(n)`pat /= p_null THEN "{" + doublequote + "node" + doublequote + ":" + n + "," + doublequote + "pd" + doublequote + ":" + l(n) + "}" ELSE node_to_pd_printer(l, n - 1) ENDIF
    ENDCOND
  MEASURE n

has_previous_node_to_patient_printer(l: [ upto(nlimit) -> patient ], n: node, pv: patient): RECURSIVE bool =
  COND
    n = 0 -> IF l(n) /= pv  THEN TRUE ELSE FALSE ENDIF,
    n > 0 -> IF l(n) /= pv  THEN TRUE ELSE has_previous_node_to_patient_printer(l, n-1, pv) ENDIF 
  ENDCOND
  MEASURE n

node_to_patient_printer(l: [ upto(nlimit) -> patient ], n: node, pv: patient): RECURSIVE string =
    COND
      n = 0 -> IF l(n) /= pv THEN "{" + doublequote + "node" + doublequote + ":" + n + "," + doublequote + "patient" + doublequote + ":" + l(n) + "}" ELSE
               "" ENDIF,
      n > 0 -> IF l(n) /= pv AND has_previous_node_to_patient_printer(l, n-1, pv)
               THEN node_to_patient_printer(l, n - 1, pv) + "," + newline +  "{" + doublequote + "node" + doublequote + ":" + n + "," + doublequote + "patient" + doublequote + ":" + l(n) + "}"
	       ELSIF l(n) /= pv THEN "{" + doublequote + "node" + doublequote + ":" + n + "," + doublequote + "patient" + doublequote + ":" + l(n) + "}" ELSE node_to_patient_printer(l, n - 1, pv) ENDIF
    ENDCOND
  MEASURE n

has_previous_act_buff_printer(l: [ upto(mindex) -> act_message_type ], i: index): RECURSIVE bool =
  COND
    i = 0 -> IF l(i)`mhdr /= nomsg  THEN TRUE ELSE FALSE ENDIF,
    i > 0 -> IF l(i)`mhdr /= nomsg THEN TRUE ELSE has_previous_act_buff_printer(l, i-1) ENDIF 
  ENDCOND
  MEASURE i

act_buff_printer(l: [ upto(mindex) -> act_message_type ], i: index): RECURSIVE string =
    COND
      i = 0 -> IF l(i)`mhdr /= nomsg THEN "" + l(i) + newline ELSE
               "" ENDIF,
      i > 0 -> IF l(i)`mhdr /= nomsg AND has_previous_act_buff_printer(l, i-1)
               THEN act_buff_printer(l, i - 1) + "," + newline + l(i)
	       ELSIF l(i)`mhdr /= nomsg THEN l(i) ELSE act_buff_printer(l, i - 1) ENDIF
    ENDCOND
  MEASURE i

has_previous_pan_buff_printer(l: [ upto(mindex) -> pan_message_type ], i: index): RECURSIVE bool =
  COND
    i = 0 -> IF l(i)`mhdr /= nomsg  THEN TRUE ELSE FALSE ENDIF,
    i > 0 -> IF l(i)`mhdr /= nomsg THEN TRUE ELSE has_previous_pan_buff_printer(l, i-1) ENDIF 
  ENDCOND
  MEASURE i

pan_buff_printer(l: [ upto(mindex) -> pan_message_type ], i: index): RECURSIVE string =
    COND
      i = 0 -> IF l(i)`mhdr /= nomsg THEN "" + l(i) + newline ELSE
               "" ENDIF,
      i > 0 -> IF l(i)`mhdr /= nomsg AND has_previous_pan_buff_printer(l, i-1)
               THEN pan_buff_printer(l, i - 1) + "," + newline + l(i)
	       ELSIF l(i)`mhdr /= nomsg  THEN l(i) ELSE pan_buff_printer(l, i - 1) ENDIF
    ENDCOND
  MEASURE i

has_previous_patient_pan_printer(l: [ upto(mindex) -> panel ], p: patient): RECURSIVE bool =
  COND
    p = 0 -> IF l(p)`pars /= emptyset THEN TRUE ELSE FALSE ENDIF,
    p > 0 -> IF l(p)`pars /= emptyset THEN TRUE ELSE has_previous_patient_pan_printer(l, p-1) ENDIF 
  ENDCOND
  MEASURE p

patient_pan_printer(l: [ upto(mindex) -> panel ], p: patient): RECURSIVE string =
COND
      p = 0 -> IF l(p)`pars /= emptyset THEN "" + l(p) ELSE
               "" ENDIF,
      p > 0 -> IF l(p)`pars /= emptyset AND has_previous_patient_pan_printer(l, p-1)
               THEN patient_pan_printer(l, p - 1) + "," + newline + l(p)
	       ELSIF l(p)`pars /= emptyset THEN l(p) ELSE patient_pan_printer(l, p - 1) ENDIF
    ENDCOND
  MEASURE p

patient_mode_type2string(m: patient_mode_type): string =
   COND
    m = error -> doublequote + "error" + doublequote,
    m = top     -> doublequote + "top" + doublequote,
    m = p_mode -> doublequote + "p_mode" + doublequote,
    m = d_mode -> doublequote + "d_mode" + doublequote  
    ENDCOND
  CONVERSION patient_mode_type2string

patient_edit_type2string(m: patient_edit_type): string =
   COND
    m = edit_none -> doublequote + "edit_none" + doublequote,
    m = edit_top -> doublequote + "edit_top" + doublequote,
    m = edit_patient -> doublequote + "edit_patient" + doublequote,
    m = edit_device -> doublequote + "edit_device" + doublequote,
    m = edit_rule -> doublequote + "edit_rule" + doublequote,
    m = edit_constraint -> doublequote + "edit_constraint" + doublequote
   ENDCOND
 CONVERSION patient_edit_type2string

nodes2string(ns: nodes): string =
  "[" + node_printer_bool(ns, nlimit) + " ]"
 CONVERSION nodes2string

devices2string(ds: devices): string =
  "[ " + device_printer_bool(ds, dlimit) + "]"
CONVERSION devices2string

patients_type2string(ps: patients_type): string =
  "[ " + patient_printer_bool(ps, plimit) + "]"
 CONVERSION patients_type2string

devices_type2string(ds:devices_type): string =
  "[ " + devs_printer_type(ds, dlimit) + "]"
 CONVERSION devices_type2string

act_buff_type2string(ab: act_buff_type): string =
  "[ " + act_buff_printer(ab, mindex) + "]"
  CONVERSION act_buff_type2string

pan_buff_type2string(pb: pan_buff_type): string =
  "[ " + pan_buff_printer(pb, mindex) + "]"
  CONVERSION pan_buff_type2string


pan_q_type2string(pq: pan_q_type): string =
 "{" + doublequote + "current_pos" + doublequote + ": " + pq`current_pos +  ", "+ space +
       doublequote + "last_pos" + doublequote + ": " + pq`last_pos +  ", "+ space +
       doublequote + "buff" + doublequote + ": " + pq`buff +  ", "+ space +
       doublequote + "buf_status" + doublequote + ": " + pq`buf_status + " }"
  CONVERSION pan_q_type2string

act_q_type2string(aq: act_q_type): string =
 "{" + doublequote + "current_pos" + doublequote + ": " + aq`current_pos +  ", "+ space +
       doublequote + "last_pos" + doublequote + ": " + aq`last_pos +  ", "+ space +
       doublequote + "buff" + doublequote + ": " + aq`buff +  ", "+ space +
       doublequote + "buf_status" + doublequote + ": " + aq`buf_status + " }"
  CONVERSION act_q_type2string

d_state2string(ds: d_state): string =
   "{" + doublequote + "dev" + doublequote + ": " + ds`dev +  ", "+ newline +
       doublequote + "nde" + doublequote + ": " + ds`nde +  ", "+ newline +
       doublequote + "vtbi" + doublequote + ": " + ds`vtbi +  ", "+ newline +
       doublequote + "rate" + doublequote + ": " + ds`rate +  ", "+ newline +
       doublequote + "time" + doublequote + ": " + ds`time +  ", "+ newline +
       doublequote + "vol" + doublequote + ": " + ds`vol +  ", "+ newline +
       doublequote + "clamp" + doublequote + ": " + ds`clamp +  ", "+ newline +
       doublequote + "m" + doublequote + ": " + ds`m +  ", "+ newline +
       doublequote + "dm" + doublequote + ": " + ds`dm +  ", "+ newline +
       doublequote + "prevdm" + doublequote + ": " + ds`prevdm +  ", "+ newline +
       doublequote + "clock" + doublequote + ": " + ds`clock +  ", "+ newline +
       doublequote + "bolus_time" + doublequote + ": " + ds`bolus_time +  ", "+ newline +
       doublequote + "pan" + doublequote + ": " + ds`pan +  ", "+ newline +
       doublequote + "priority" + doublequote + ": " + ds`priority +  ", "+ newline +
       doublequote + "ip_error" + doublequote + ": " + ds`ip_error + " }"
