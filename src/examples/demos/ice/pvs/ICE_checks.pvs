    st1 = patient_menu_act(select, p, st1),
    st1 = patient_menu_act(parameter, p, st1), 
    ps1 = st1`pdb(p) IN
check_constrainth5(p, d, v, st, nde1, nde2, nde3)
IMPLIES
p_rules_display(ps1)`select_pars(sp)

check_constrainth6(p: patient, d, v: device, st: state, nde1, nde2, nde3: node): boolean =
check_constrainth5(p, d, v, st, nde1, nde2, nde3) AND
p_rules_display(st`pdb(p))`select_pars(sp) 

