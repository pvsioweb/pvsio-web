newconstraint(a: action_id, d: device, p: patient, st: state): boolean =
LET ps = st`pdb(p),
    ds = (ps`ip_state)(d),
    ns = st`nde_state,
    pn = ps`nde,
    dn = ds`nde,
    is = st`coord_st,
    acts = (is`disp_patient)`patient_actions(d),
    amsg: act_message_type = (# mhdr := actmsg,
    pat_nd := pn,
    msg_nd := dn,
    act := a #) IN
 (ns`n_links(coord_node, pn) AND
  ns`n_links(pn, dn) AND
  (mode(is) = d_mode) AND
  ((ps`p_disp_top)`devs(d) = infusion_pump) AND
  ((is`disp_patient)`selected_device = d) AND
  ((is`disp_device)`current_device = d) AND
  (is`disp_focus = device_focus) AND
  ((is`disp_patient)`current_patient = p) AND
  (is`disp_device)`av_c_disp(a) AND
  ((is`disp_device)`selected_action = a) AND
  ((is`disp_top)`ent_action = a) AND
  ((ns`act_msg_waiting(pn))`buf_status /= full) AND
  ((ns`act_msg_waiting(dn))`buf_status /= full) AND
  (((is`disp_top)`menu_visible)(act)) AND
  (ns`act_msg_waiting =
          LAMBDA (n: node):
               IF n = pn
               THEN add_act_buff(amsg, ns`act_msg_waiting(pn))
               ELSE ns`act_msg_waiting(n)
               ENDIF))
