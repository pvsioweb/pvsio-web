sm4_pred(p: patient, st: state): boolean =
LET is = st`coord_st IN
 ((is`mode = top) AND
   (is`disp_top)`patients(p) AND
   ((is`disp_top)`ent_patient = p) AND
   (is`prev_menu_entry = select) AND
   (is`prev_menu_visible = top_menu) AND
   ((is`disp_top)`menu_visible = 
     select_options_menu) AND
     (st`coord_menu = init_coord_menu))

%QED 18/12/20
coordinator_sm5_check: THEOREM
FORALL (p: patient, st: state):
LET st1 = coord_menu_act(patient, st),
    is = st`coord_st,
    is1 = st1`coord_st

IN (sm4_pred(p, st) 
   IMPLIES 
   ((is1`disp_top)`selected_patient = p) AND
   (is1`prev_menu_entry = select) AND
   (is`prev_menu_visible = top_menu) AND
   ((is1`disp_top)`menu_visible = top_menu))

