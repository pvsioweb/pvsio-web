   FORALL (a: action_id, d: device, p: patient, st: state):
       LET st1 = coord_act_mono(st),
           st2 = tick_act_patient(p, st1),
           ps = st`pdb(p),
           ps1 = st1`pdb(p),
           ds = (ps`ip_state)(d),
           ns = st`nde_state,
	   ns1 = st1`nde_state,
	   ns2 = st2`nde_state,
           n1 = ps`nde,
           is = st`coord_st,
           acts = (is`disp_patient)`patient_actions(d),
           amsg: act_message_type = (# mhdr := actmsg,
                     pat_nd := ps`nde,
                     msg_nd := ds`nde,
                     act := a
                    #)
       IN 
          (ns`n_links(coord_node, n1) AND (mode(is) = d_mode) AND
	  ((ps`p_disp_top)`devs(d) = infusion_pump) AND
          ((is`disp_patient)`selected_device = d) AND
	 ((is`disp_device)`current_device = d) AND
	  (is`disp_focus = device_focus) AND
	  ((is`disp_patient)`current_patient = p) AND
          (is`disp_device)`av_c_disp(a) AND
      ((is`disp_device)`selected_action = a) AND
      ((is`disp_top)`ent_action = a) AND
           ((ns`act_msg_waiting(n1)) = empty_act_q) AND
      (((is`disp_top)`menu_visible)(act)))  IMPLIES
         ((st1`nde_state)`act_msg_waiting(n1) =
          add_act_buff(amsg, ns`act_msg_waiting(n1)))
                AND
	  (ns2`current_act_msg = amsg)



