ICE_checks_th[maxrate: posnat, 
          maxinfuse: posnat, 
          maxtime: {maxtime: posnat | maxinfuse <= maxtime}]:%,
         % node_limit, max_index, aq_limit, pq_limit, d_limit: posnat, 
         % p_limit: posnat]:

THEORY 
BEGIN 
IMPORTING system_th[maxrate, 
          maxinfuse, 
          maxtime]%,
      %   node_limit, max_index, aq_limit, pq_limit, d_limit, 
      %    p_limit]


d_state_transitions(pre, post: d_state): boolean =
  (per_pause(pre) & post = fun_pause(pre)) OR  
  (per_infuse(pre) & post = fun_infuse(pre)) OR
  (per_choosetime(pre) & post = fun_choosetime(pre)) OR
(per_chooserate(pre) & post = fun_chooserate(pre)) OR  
 (per_choosevtbi(pre) & post = fun_choosevtbi(pre)) OR 
(per_choosetime(pre) & post = fun_choosetime(pre)) OR
  (per_confirm(pre) & post = fun_confirm(pre)) OR 
(per_open_clamp(pre) & post = fun_open_clamp(pre)) OR
(per_close_clamp(pre) & post = fun_close_clamp(pre)) OR
  (per_incr(pre) & post = fun_incr(pre)) OR  
(per_decr(pre) & post = fun_decr(pre)) OR
(per_bolus(pre) & post = fun_bolus(pre))

%coord_d_display(d: device, p: patient, st: state): panel
% = LET pc = (st`coord_st)`coord_db(p) IN
%    (# pars := pc`param_set,
%       enum_disp := (pc`p_enum_params)(d),
%       num_disp := (pc`p_num_params)(d),
%       cmds := (pc`p_actions)(d) #)

device_d_display(d: device, p: patient, st: state): panel
  = LET dc = (st`pdb(p))`ip_state(d) IN dc`pan



% checks that an action message is added to the appropriate buffer
% QED 22/12/20
interimupdcheck: THEOREM
   FORALL (a: action_id, d: device, p: patient, st: state):
       LET st1 = execute_patient_device(a, p, d, st),
           ps = st`pdb(p),
           ps1 = st1`pdb(p),
           ds = (ps`ip_state)(d),
           ns = st`nde_state,
           n1 = ps`nde,
           is = st`coord_st,
           amsg: act_message_type = (# mhdr := actmsg,
                     pat_nd := ps`nde,
                     msg_nd := ds`nde,
                     act := a
                    #)
       IN 
          (ns`n_links(coord_node, n1) AND (mode(is) = d_mode) AND
	  ((ps`p_disp_top)`devs(d) = infusion_pump) AND
          ((is`disp_device)`current_device = d) AND
	  ((is`disp_patient)`current_patient = p) AND
          (is`disp_device)`av_c_disp(a) AND 
          ((ns`act_msg_waiting(n1))`buf_status /= full))  IMPLIES
         (st1`nde_state)`act_msg_waiting =
          LAMBDA (n: node):
               IF n = n1
               THEN add_act_buff(amsg, ns`act_msg_waiting(n1))
               ELSE ns`act_msg_waiting(n)
               ENDIF

