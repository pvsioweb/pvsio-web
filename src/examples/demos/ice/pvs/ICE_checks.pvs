check_next_act_patient: THEOREM
   FORALL (a: action_id, d: device, p: patient, st: state):
       LET st1 = next_act_patient(p, st),
           ps = st`pdb(p),
           ps1 = st1`pdb(p),
           ds = (ps`ip_state)(d),
           ns = st`nde_state,
           np = ps`nde,
           nd = ds`nde,
           amsg: act_message_type = (# mhdr := actmsg,
                     pat_nd := ps`nde,
                     msg_nd := ds`nde,
                     act := a
                    #),
           amw = LAMBDA (n: node): empty_act_q
       IN 
          (ns`n_links(coord_node, np) AND ns`n_links(np, nd) AND
	  ((ps`p_disp_top)`devs(d) = infusion_pump) AND
          ((ns`act_msg_waiting(nd))`buf_status = empty) AND
          ns`act_msg_waiting = LAMBDA (n: node):
               IF n = np
               THEN add_act_buff(amsg, amw(np))
               ELSE amw(n)
               ENDIF)  IMPLIES
         (st1`nde_state)`current_act_msg = amsg

check_tick_patient: THEOREM
   FORALL (a: action_id, d: device, p: patient, st: state):
       LET st1 = tick_act_patient(p, st),
           ps = st`pdb(p),
           ps1 = st1`pdb(p),
           ds = (ps`ip_state)(d),
           ns = st`nde_state,
           np = ps`nde,
           nd = ds`nde,
           amsg: act_message_type = (# mhdr := actmsg,
                     pat_nd := ps`nde,
                     msg_nd := ds`nde,
                     act := a
                    #),
           amw = LAMBDA (n: node): empty_act_q
       IN 
          (ns`n_links(coord_node, np) AND ns`n_links(np, nd) AND
	  ((ps`p_disp_top)`devs(d) = infusion_pump) AND
          ((ns`act_msg_waiting(nd))`buf_status = empty) AND
          ns`act_msg_waiting = LAMBDA (n: node):
               IF n = np
               THEN add_act_buff(amsg, amw(np))
               ELSE amw(n)
               ENDIF)  IMPLIES
         (st1`nde_state)`current_act_msg = amsg
          
