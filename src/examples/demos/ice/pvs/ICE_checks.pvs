setup_check1: THEOREM
FORALL (p: patient, st: state):
LET st1 = connect_to_coordinator(p, st),
    is1 = st1`coord_st,
    ps1 = st1`pdb(p),
    cnde = (st`nde_state)`current_node
  IN (p /= p_null) AND ((st`pdb(p))`id = null_pid) AND (cnde < nlimit)
  IMPLIES
     (((is1`disp_alarm)`patient_connected)(p) = clear) AND
     (is1`disp_alarm)`patient_updates(p) AND
     (st1`ps)(p) AND (st1`p_nodes(cnde) = p) AND
     st1`patient_nodes(cnde) AND ps1`id = p AND
     (ps1`nde = cnde) AND (is1`disp_top)`patients(p)

%QED Run time  = 63.91 secs. 22/12/20
setup_check1a: THEOREM
FORALL (p: patient, st: state):
LET st1 = connect_to_coordinator(p, st),
    is1 = st1`coord_st,
    ps1 = st1`pdb(p),
    cnde = (st`nde_state)`current_node
  IN (p /= p_null) AND ((st`pdb(p))`id = null_pid) AND (cnde < nlimit) AND
     (((st`pdb(p))`p_disp_top)`menu_visible)(connect)
  IMPLIES
     (((is1`disp_alarm)`patient_connected)(p) = clear) AND
     (is1`disp_alarm)`patient_updates(p) AND
     (st1`ps)(p) AND (st1`p_nodes(cnde) = p) AND
     st1`patient_nodes(cnde) AND ps1`id = p AND
     (ps1`nde = cnde) AND (is1`disp_top)`patients(p)

first_constraint(p: patient, st: state): boolean =
     (p /= p_null) AND ((st`pdb(p))`id = null_pid) AND
     (((st`pdb(p))`p_disp_top)`menu_visible)(connect) AND
     ((((st`coord_st)`disp_alarm)`patient_connected)(p) = clear) AND
     ((st`coord_st)`disp_alarm)`patient_updates(p) AND
     (st`ps)(p)
      AND (st`pdb)(p)`id = p
     AND ((st`coord_st)`disp_top)`patients(p)
%QED Run time  = 227.06 secs. 22/12/20
setup_check2: THEOREM
FORALL (p: patient, d: device, st: state):
LET st1 =  connect_device_to_patient(p, d, infusion_pump,
                          st),
    is1 = st1`coord_st,
    ps1 = st1`pdb(p),
    ds1 = ps1`ip_state(d),
    cnde = (st`nde_state)`current_node,
    cnde1 = (st1`nde_state)`current_node
     IN first_constraint(p, st)
     AND (d /= nil_device) AND ((is1`disp_patient)`selected_device = nil_device) AND
     (p_devices((is1`coord_db(p)))(d) = no_device) AND  (cnde + 1 < nlimit) AND
      (st`p_nodes(cnde) = p) AND st`patient_nodes(cnde) AND ((st`pdb)(p)`nde = cnde) 
  IMPLIES
     (((is1`disp_alarm)`patient_connected)(p) = clear) AND
     (((is1`disp_alarm)`patient_device_connected(p))(d) = clear) AND
     (is1`disp_alarm)`patient_updates(p) AND
     (is1`disp_top)`patients(p) AND ((is1`disp_top)`patients)(p) AND
     (st1`ps)(p) AND (st1`p_nodes(cnde) = p) AND
     st1`patient_nodes(cnde) AND ps1`id = p AND
     ((st1`d_nodes)(cnde1)`pat = p) AND ((st1`d_nodes)(cnde1)`dev = d ) AND
     (ps1`nde = cnde) AND (is1`disp_top)`patients(p) AND
     (ps1`patient_panels(d) = ds1`pan) AND (ds1`dev = d) AND
     (ds1`nde = cnde1) AND (is1`disp_alarm)`device_update(d) AND
     (is1`coord_db(p)`coord_devices(d) = empty_panel)

check_constraint(p: patient, d: device, st: state, nde1, nde2: node): boolean =
LET is = st`coord_st, ps = st`pdb(p), ds = ps`ip_state(d), ns = nde_state(st)  IN
ns`n_links(nde1, coord_node) AND ns`n_links(nde1, nde2) AND nde1 /= nde2 AND coord_node /= nde1
AND coord_node /= nde2 AND
(p /= p_null) AND ((st`pdb(p))`id = null_pid) AND (nde1 + 1 < nlimit) AND
     (nde2 + 1 < nlimit) AND (nde1 /= no_node) AND (nde2 /= no_node)
     AND (d /= nil_device) AND ((is`disp_patient)`selected_device = nil_device) AND
     (p_devices((is`coord_db(p)))(d) =infusion_pump) AND
      (((is`disp_alarm)`patient_connected)(p) = clear) AND
     (((is`disp_alarm)`patient_device_connected(p))(d) = clear) AND
     (is`disp_alarm)`patient_updates(p) AND
     (is`disp_top)`patients(p) AND
     (st`ps)(p) AND (st`p_nodes(nde1) = p) AND
     st`patient_nodes(nde1) AND ps`id = p AND
     ((st`d_nodes)(nde1)`pat = p) AND ((st`d_nodes)(nde2)`dev = d ) AND
     (ps`nde = nde1) AND
     (ps`patient_panels(d) = ds`pan) AND (ds`dev = d) AND
     (ds`nde = nde2) AND (is`disp_alarm)`device_update(d) AND
     (is`coord_db(p)`coord_devices(d) = empty_panel) AND
     (st`patient_menus = init_patient_menu)

setup_check3a: THEOREM
FORALL (p: patient, d: device, st: state, nde1, nde2: node):
LET st1 = patient_menu_act(select, p, st),
    ps = st`pdb(p),
    ps1 = st1`pdb(p), ds1 = ps1`ip_state(d) IN 
check_constraint(p, d, st, nde1, nde2) AND (ps`pmode = d_mode) AND
(ps`emode = edit_none) AND ((ps`p_disp_top)`menu_visible = edit_none_menu)
IMPLIES
((ps1`prev_menu_visible = edit_none_menu) AND ((ps`p_disp_top)`menu_visible = enter_options_menu))

