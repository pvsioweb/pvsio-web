%QED Run time  = 0.54 secs. 22/12/20
send_next_symmetry: THEOREM
    FORALL(n1, n2: node, msg:act_message_type, ns: n_state):
    ns`n_links(n1, n2) AND (ns`act_msg_waiting = LAMBDA (n: node): empty_act_q)
    IMPLIES
    LET ns1 = act_send(n1, n2, msg, ns) IN
     (next_act_pm(n2, ns1)`current_act_msg = msg) AND
     ((ns1`act_msg_waiting)(n2)`buf_status = functioning)
     
%QED Run time  = 0.73 secs. 22/12/20
send_next_symmetry1: THEOREM
    FORALL(n1, n2: node, msg:pan_message_type, ns: n_state):
    ns`n_links(n1, n2) AND (ns`pan_msg_waiting = LAMBDA (n: node): empty_pan_q)
    IMPLIES
    LET ns1 = pan_send(n1, n2, msg, ns), ns2 = next_pan_pm(n2, ns1) IN
     (ns2`current_pan_msg = msg) AND
     ((ns1`pan_msg_waiting)(n2)`buf_status = functioning) AND
     ((ns2`pan_msg_waiting)(n2)`buf_status = empty)
     
