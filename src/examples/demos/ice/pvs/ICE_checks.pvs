check_constrainth4(p, d, v, st, nde1, nde2, nde3)
IMPLIES
p_rules_display(ps1)`select_pars(blph)

check_constrainth5(p: patient, d, v: device, st: state, nde1, nde2, nde3: node): boolean =
check_constrainth4(p, d, v, st, nde1, nde2, nde3) AND
p_rules_display(st`pdb(p))`select_pars(blph) AND
((st`pdb(p))`p_disp_device)`pars(sp)

