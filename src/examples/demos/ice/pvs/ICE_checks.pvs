coordinator_sm_check: THEOREM
FORALL (m: menu, st: state):
LET is = st`coord_st,
    st1 = coord_menu_act(m, st),
    is1 = st1`coord_st IN
    (((is`disp_top)`menu_visible)(m) IMPLIES
    (is1`prev_menu_entry = m))

