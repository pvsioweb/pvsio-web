coordinator_sm1_check: THEOREM
FORALL (p: patient, st: state):
LET st1 = coordinator_enter_patient(p, st),
    is = st`coord_st,
    is1 = st1`coord_st
IN ((is`mode = top) AND
   (is`disp_top)`patients(p)) IMPLIES
   ((is1`disp_top)`ent_patient = p)

sm1_pred(p: patient, st: state): boolean =
LET is = st`coord_st IN
 ((is`mode = top) AND
   (is`disp_top)`patients(p) AND
   ((is`disp_top)`ent_patient = p))


sm2_pred(p: patient, st: state): boolean =
LET is = st`coord_st IN
 ((is`mode = top) AND
   (is`disp_top)`patients(p) AND
   ((is`disp_top)`ent_patient = p) AND
   ((is`disp_top)`menu_visible = top_menu) AND
   (st`coord_menu = init_coord_menu))
%QED 22/12/20
coordinator_sm3_check: THEOREM
FORALL (p: patient, st: state):
LET st1 = coord_menu_act(select, st),
    is = st`coord_st,
    is1 = st1`coord_st
IN sm2_pred(p, st) 
   IMPLIES 
   ((is1`disp_top)`menu_visible(patient) AND
   ((is1`disp_top)`menu_visible = select_options_menu) AND
   (is1`prev_menu_visible = top_menu))

sm3_pred(p: patient, st: state): boolean =
LET is = st`coord_st IN
 ((is`mode = top) AND
   (is`disp_top)`patients(p) AND
   ((is`disp_top)`ent_patient = p) AND
   (is`prev_menu_visible = top_menu) AND
   ((is`disp_top)`menu_visible = select_options_menu) AND
   (st`coord_menu = init_coord_menu))
