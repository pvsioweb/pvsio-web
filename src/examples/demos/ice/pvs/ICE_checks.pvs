setup_check3: THEOREM
FORALL (p: patient, d: device, st: state, nde1, nde2: node):
LET st1 = patient_menu_act(select, p, st),
    st1 = patient_menu_act(display, p, st1), ps1 = st1`pdb(p), ds1 = ps1`ip_state(d) IN 
check_constraint(p, d, st, nde1, nde2) AND (((st`pdb(p))`p_disp_top)`menu_visible)(select)
IMPLIES
(ps1`pmode = d_mode) AND (((ps1`p_disp_top)`sel_device)`dv = d) AND (ps1`p_disp_device = ds1`pan)

check_constraint1(p: patient, d: device, st: state, nde1, nde2: node): boolean =
LET ps = st`pdb(p) IN
check_constraint(p, d, st, nde1, nde2) AND (ps`pmode = d_mode) AND (((ps`p_disp_top)`sel_device)`dv = d)

check_constraintb1(p: patient, d: device, st: state, nde1, nde2: node): boolean =
LET ps = st`pdb(p) IN
check_constraint(p, d, st, nde1, nde2) AND (ps`pmode = d_mode) AND (((ps`p_disp_top)`sel_device)`dv = d)
AND (ps`emode = edit_device) AND p_rules_display(ps)`select_pars(dpm) AND
(ps`p_disp_device)`pars(rte) AND (ps`p_disp_device)`pars(vtb) AND
(ps`p_disp_device)`pars(dpm) AND
(ps`p_disp_top)`menu_visible(select)

check_constraintc1(p: patient, d: device, st: state, nde1, nde2: node): boolean =
LET ps = st`pdb(p) IN
check_constraint(p, d, st, nde1, nde2) AND (ps`pmode = d_mode) AND (((ps`p_disp_top)`sel_device)`dv = d)
AND (ps`emode = edit_device) AND p_rules_display(ps)`select_pars(dpm) AND
     p_rules_display(ps)`select_pars(rte) AND p_rules_display(ps)`select_pars(vtb)

check_constraintd1(p: patient, d: device, st: state, nde1, nde2: node): boolean =
LET ps = st`pdb(p) IN
check_constraintc1(p, d, st, nde1, nde2) AND
p_rules_display(ps)`select_acts(powr) AND
p_rules_display(ps)`select_acts(hold) AND p_rules_display(ps)`select_acts(start)

check_constrainte1(p: patient, d: device, st: state, nde1, nde2: node): boolean =
LET ps = st`pdb(p), pa = filter_panel(ps`patient_panels(d),
                       p_rules_display(ps)`select_pars, p_rules_display(ps)`select_acts),
    ns = st`nde_state,
    pmq = ns`pan_msg_waiting(coord_node),
    amq = ns`act_msg_waiting(coord_node) IN
check_constraintd1(p, d, st, nde1, nde2) AND
(ps`patient_panels(d) = pa) AND
(pmq`buff(pmq`current_pos) = (# mhdr := pmmsg, pat_nd := nde1, msg_nd := nde2, pan := pa #)) AND
(amq = empty_act_q)

check_constraintf1(p: patient, d: device, st: state, nde1, nde2: node): boolean =
LET ps = st`pdb(p), is = st`coord_st, ns = st`nde_state IN
check_constrainte1(p, d, st, nde1, nde2) AND
((is`coord_db(p))`coord_devices(d) = ps`patient_panels(d)) AND
((ns`current_act_msg)`mhdr = nomsg)


